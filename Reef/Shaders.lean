def overlay : String :=
  "// The overlay: text, as pixels in a texture (white, its alpha the text's),\n// drawn a pixel to a pixel at a place in the target, on a translucent panel\n// a little larger, blended over what is there.\n\n// As `Reef.placementBytes` encodes it: 32 bytes, all in pixels, from the\n// target's top left.\nstruct Placement {\n  extent  : vec2f,  // the target's size\n  origin  : vec2f,  // the text's top left\n  size    : vec2f,  // the text's size\n  padding : f32,    // the panel's, around the text\n  pad     : f32,\n}\n\n@group(0) @binding(0) var<uniform> placement : Placement;\n@group(0) @binding(1) var text : texture_2d<f32>;\n\n@vertex fn vs(@builtin(vertex_index) v : u32) -> @builtin(position) vec4f {\n  // Two triangles: the panel's corners, 0..1 across and down.\n  var corners = array<vec2f, 6>(\n    vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0),\n    vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n  let pad = vec2f(placement.padding);\n  let p = placement.origin - pad + corners[v] * (placement.size + 2.0 * pad);\n  // Pixels, down from the top, to clip space, up from the bottom.\n  let clip = p / placement.extent * 2.0 - 1.0;\n  return vec4f(clip.x, -clip.y, 0.0, 1.0);\n}\n\n@fragment fn fs(@builtin(position) position : vec4f) -> @location(0) vec4f {\n  // The pixel's place in the text: its centre is at + 0.5.\n  let p = floor(position.xy - placement.origin);\n  var coverage = 0.0;\n  if (all(p >= vec2f(0.0)) && all(p < placement.size)) {\n    coverage = textureLoad(text, vec2i(p), 0).a;\n  }\n  let panel = vec4f(0.01, 0.04, 0.07, 0.55);\n  let ink = vec4f(0.7, 0.95, 1.0, 1.0);\n  return mix(panel, ink, coverage);\n}\n"

/-- `shaders/ripples.wgsl`. -/
def ripples : String :=
  "// The ripples' tile, baked once at the start (`Reef/Ripples.lean`): the\n// sand's wave ripples, in their own frame (the waves run along x, so the\n// crests run along y), as a texture that repeats. Each texel: the height,\n// 0 the lowest to 1 the highest; the slopes along x and y, in heights per\n// wavelength, as (slope / 8 + 0.5); and the cavity, how much of the sky a\n// point in a trough sees, 1 all of it. `shaders/sand.wgsl` reads them.\n//\n// The ripples are phasor noise (Tricard et al., \"Procedural Phasor\n// Noise\", 2019): a sum of kernels, bumps, each carrying a plane wave,\n// whose phase, where they interfere, is a field that oscillates at about\n// the ripples' frequency everywhere. Each kernel's wave is the ripples'\n// direction and frequency as a smooth field has them at the kernel: so\n// neighbours agree, the crests bend as the field does, and where it\n// bends enough that a crest must end or fork, one does, as ripples'\n// crests do. A profile of the phase is the height: a long gentle rise to\n// a sharp crest, a short steep fall down its lee, a round trough. On\n// that, small ripples, the same field at a few times the frequency, and\n// scour pits, hollows scattered sparsely and sunk where the troughs are.\n// The field is periodic over the tile, and each wave has a whole number\n// of cycles across it, so the tile repeats.\n//\n// Three passes: `fs_height` writes the height alone (a kernel sum a\n// texel); `fs_finish` reads it back for the slopes and the cavity, and\n// `fs_horizons` for the horizons, which need the height at many points\n// each.\n\nstruct Bake {\n  // Ripples across the tile; how far the ripples' direction strays from\n  // the waves', in radians; how far out of step the kernels are, 0 none\n  // to 1 wholly; the crests' sharpness, a power.\n  shape : vec4f,\n  // The ripples' steepness, trough to crest over the wavelength, for the\n  // cavity; the tile's texels a side; how much of the wavelength the\n  // gentle rise takes, 0.5 symmetric; the small ripples' height, as a\n  // fraction of the ripples'.\n  size  : vec4f,\n  // The pits: how many a wavelength's square (0 to 1); their depth, as a\n  // fraction of the ripples' height; z, w unused.\n  pits  : vec4f,\n}\n\n@group(0) @binding(0) var<uniform> bake : Bake;\n@group(0) @binding(1) var heights : texture_2d<f32>;\n\nconst tau = 6.283185307;\nconst kernelsPerCell = 8u;\n// The direction's and the frequency's fields: this many features across\n// the tile.\nconst bends = 4.0;\n// The small ripples: this many to one of the ripples.\nconst fineRipples = 4.0;\n// A pit's half-width across the trough and along it, in wavelengths:\n// under 1, so that the cells around a point hold every pit reaching it.\nconst pitAcross = 0.35;\nconst pitAlong = 0.7;\n// The small ripples come in patches: this many across the tile.\nconst patches = 8.0;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n// One triangle over the whole target; the fragment's position says where.\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\n// A number in [0, 1) from `seed`, the `n`th of its sequence.\nfn rand(seed : u32, n : u32) -> f32 {\n  var h = seed + n * 0x9e3779b9u;\n  h = h ^ (h >> 16u);\n  h = h * 0x7feb352du;\n  h = h ^ (h >> 15u);\n  h = h * 0x846ca68bu;\n  h = h ^ (h >> 16u);\n  return f32(h & 0xffffffu) / 16777216.0;\n}\n\n// The seed of the cell `cell` of a grid `n` wide over the tile, the grid\n// repeating with it, salted by `salt`.\nfn cellSeed(cell : vec2i, n : i32, salt : u32) -> u32 {\n  let wrapped = ((cell % n) + n) % n;\n  return (u32(wrapped.x) * 0x8da6b343u) ^ (u32(wrapped.y) * 0xd8163841u) ^ salt;\n}\n\n// A gradient at the lattice point `p` of a lattice `period` wide, which\n// repeats: a direction, not unit.\nfn gradient(p : vec2i, period : i32) -> vec2f {\n  var h = cellSeed(p, period, 0u);\n  h = h ^ (h >> 15u);\n  h = h * 0x2c1b3c6du;\n  h = h ^ (h >> 12u);\n  let a = f32(h & 0xffffu) / 65535.0;\n  let b = f32((h >> 16u) & 0xffffu) / 65535.0;\n  return vec2f(a, b) * 2.0 - 1.0;\n}\n\n// Gradient noise at `p`, repeating every `period`: smooth, about -1 to 1,\n// a feature a unit wide.\nfn noise(p : vec2f, period : i32) -> f32 {\n  let i = vec2i(floor(p));\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  let a = dot(gradient(i, period), f);\n  let b = dot(gradient(i + vec2i(1, 0), period), f - vec2f(1.0, 0.0));\n  let c = dot(gradient(i + vec2i(0, 1), period), f - vec2f(0.0, 1.0));\n  let d = dot(gradient(i + vec2i(1, 1), period), f - vec2f(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 1.4;\n}\n\n// The ripples' wave at `p`, in tile units, for ripples `scale` times as\n// fine as the ripples: their direction, which strays from the waves' by\n// up to the spread (the small ripples straying further, on their own\n// account), and their frequency, which strays by a tenth, each as a\n// smooth field over the tile; in cycles across the tile, whole, so that\n// the tile repeats.\nfn waveAt(p : vec2f, scale : f32) -> vec2f {\n  var angle = bake.shape.y * noise(p * bends, i32(bends));\n  if (scale > 1.0) {\n    angle += 0.35 * noise(p * bends * 2.0 + 5.0, i32(bends * 2.0));\n  }\n  let frequency = bake.shape.x * (1.0 + 0.1 * noise(p * bends + 17.0, i32(bends)));\n  return round(scale * frequency * vec2f(cos(angle), sin(angle)));\n}\n\n// The kernels' sum at `p`, in tile units (0 to 1 across the tile, and\n// on, the tile repeating), and their weights' sum, for ripples `scale`\n// times as fine as the ripples (1 the ripples themselves): the phase is\n// the sum's argument; its length against the weights' says how far the\n// kernels agree there. The kernels sit in cells two wavelengths wide, a\n// few to a cell, each a bump a cell wide, those of the cells around `p`\n// summed; a cell's kernels are those of its cell in the tile, so that\n// the tile repeats.\nfn phasor(p : vec2f, scale : f32) -> vec3f {\n  let disorder = bake.shape.z;\n  let cells = bake.shape.x * scale / 2.0;\n  let n = i32(cells);\n  let base = vec2i(floor(p * cells));\n  var sum = vec2f(0.0);\n  var weights = 0.0;\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let cell = base + vec2i(i, j);\n      for (var k = 0u; k < kernelsPerCell; k++) {\n        let seed = cellSeed(cell, n, k * 0xcb1ab31fu + u32(scale) * 0x3d4d51cbu);\n        let centre = (vec2f(cell) + vec2f(rand(seed, 0u), rand(seed, 1u))) / cells;\n        let wave = waveAt(centre, scale);\n        // A bump a cell wide, and nothing beyond: the cells around are\n        // all that is summed, and a kernel reaching past them would be\n        // cut off at their edge, a line through the tile.\n        let d = (p - centre) * cells;\n        let r2 = dot(d, d);\n        let weight = select(0.0, (1.0 - r2) * (1.0 - r2), r2 < 1.0);\n        // The wave's phase from the tile's origin, not the kernel's: so\n        // kernels of one wave agree, and only those of different waves,\n        // or put out of step, interfere.\n        let phi = tau * (dot(wave, p) + disorder * rand(seed, 2u));\n        sum += weight * vec2f(cos(phi), sin(phi));\n        weights += weight;\n      }\n    }\n  }\n  return vec3f(sum, weights);\n}\n\n// How far the crests are rounded: a little, so that the normal has no\n// one-texel cusp to show as a line along every crest.\nconst rounding = 0.02;\n\n// The height for a phase, were the ripples symmetric: 1 at a crest\n// (phase 0), 0 in a trough; the crests sharp (though rounded a little)\n// and the troughs round, more so the lower the power.\nfn symmetric(phi : f32) -> f32 {\n  let p = bake.shape.w;\n  let lo = pow(rounding, p);\n  let hi = pow(1.0 + rounding, p);\n  return 1.0 - (pow((1.0 - cos(phi)) * 0.5 + rounding, p) - lo) / (hi - lo);\n}\n\n// The height for a phase: the symmetric profile's, with the cycle\n// warped so that the fall from the crest down its lee (the phase runs\n// along the waves) takes the short part of the wavelength and the rise\n// up the next the long part. The trough, where the symmetric profile is\n// flat, stays smooth across the warp's kink; the crest is a kink anyway.\nfn profile(phi : f32) -> f32 {\n  let rise = bake.size.z;\n  let fall = 1.0 - rise;\n  let t = fract(phi / tau);\n  let warped = select(0.5 + 0.5 * (t - fall) / rise, 0.5 * t / fall, t < fall);\n  return symmetric(tau * warped);\n}\n\n// The ripples' height from the kernels' sum `s`: the profile of the\n// phase, tapering where the kernels disagree (the sum short against the\n// weights), as a crest tapers out where it ends or forks; the phase\n// alone would jump there, a cliff. Not to nothing: a quarter of the\n// height stays, faint ripples rather than a flat, and where the phase\n// does jump, a step a quarter the size.\nfn rippleOf(s : vec3f) -> f32 {\n  let agreement = length(s.xy) / s.z;\n  let taper = mix(0.25, 1.0, smoothstep(0.02, 0.15, agreement));\n  return mix(0.5, profile(atan2(s.y, s.x)), taper);\n}\n\n// How much of a pit `p` is in, 0 none to 1 the bottom of one: pits are\n// scattered one to some of the wavelength's squares, each a bowl longer\n// along the troughs than across them.\nfn pitsAt(p : vec2f) -> f32 {\n  let n = i32(bake.shape.x);\n  let base = vec2i(floor(p * f32(n)));\n  var pit = 0.0;\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let cell = base + vec2i(i, j);\n      let seed = cellSeed(cell, n, 0x5bd1e995u);\n      if (rand(seed, 0u) < bake.pits.x) {\n        let centre = (vec2f(cell) + vec2f(rand(seed, 1u), rand(seed, 2u))) / f32(n);\n        let d = (p - centre) * f32(n) / vec2f(pitAcross, pitAlong);\n        let q = dot(d, d);\n        pit += select(0.0, (1.0 - q) * (1.0 - q), q < 1.0);\n      }\n    }\n  }\n  return min(pit, 1.0);\n}\n\n// The height at `p`: the ripples', the small ripples' on them, in\n// patches, and the pits sunk into them where they are low (a pit on a\n// crest is no pit), the three summed and scaled back to 0 to 1\n// (`Reef.Ripples.height` is the sum's scale).\nfn heightOf(p : vec2f) -> f32 {\n  let fine = bake.size.w;\n  let depth = bake.pits.y;\n  let ripples = rippleOf(phasor(p, 1.0));\n  let patchy = smoothstep(-0.2, 0.5, noise(p * patches + 31.0, i32(patches)));\n  let small = mix(0.5, rippleOf(phasor(p, fineRipples)), patchy);\n  let pit = pitsAt(p) * (1.0 - ripples);\n  return (ripples + fine * small + depth * (1.0 - pit)) / (1.0 + fine + depth);\n}\n\n@fragment fn fs_height(in : Out) -> @location(0) vec4f {\n  let uv = in.position.xy / bake.size.y;\n  return vec4f(heightOf(uv), 0.0, 0.0, 1.0);\n}\n\n// The height baked at texel `t`, the tile repeating.\nfn heightAt(t : vec2i) -> f32 {\n  let n = i32(bake.size.y);\n  return textureLoad(heights, ((t % n) + n) % n, 0).r;\n}\n\n@fragment fn fs_finish(in : Out) -> @location(0) vec4f {\n  let t = vec2i(in.position.xy);\n  let h = heightAt(t);\n  // A texel, in wavelengths.\n  let texel = bake.shape.x / bake.size.y;\n  let sx = (heightAt(t + vec2i(1, 0)) - heightAt(t - vec2i(1, 0))) / (2.0 * texel);\n  let sy = (heightAt(t + vec2i(0, 1)) - heightAt(t - vec2i(0, 1))) / (2.0 * texel);\n  // The cavity: the horizon either way along x (across the crests), as\n  // the highest rise over run out to a wavelength, at the height's\n  // steepness (the ripples' and what is on them); what is left of the\n  // sky between the two.\n  let steepness = bake.size.x * (1.0 + bake.size.w + bake.pits.y);\n  let steps = 16;\n  let stride = max(1, i32(1.0 / texel) / steps);\n  var tanP = 0.0;\n  var tanM = 0.0;\n  for (var i = 1; i <= steps; i++) {\n    let run = f32(i * stride) * texel;\n    tanP = max(tanP, (heightAt(t + vec2i(i * stride, 0)) - h) * steepness / run);\n    tanM = max(tanM, (heightAt(t - vec2i(i * stride, 0)) - h) * steepness / run);\n  }\n  let cavity = 1.0 - 0.5 * (tanP / sqrt(1.0 + tanP * tanP)\n                            + tanM / sqrt(1.0 + tanM * tanM));\n  return vec4f(h, sx / 8.0 + 0.5, sy / 8.0 + 0.5, cavity);\n}\n\n// The horizon from texel `t` along `step` (a direction, in texels): the\n// highest rise over run out to a wavelength, as an angle up from the\n// flat, 0 to 1 of a right angle.\nfn horizonAlong(t : vec2i, h : f32, step : vec2i) -> f32 {\n  let texel = bake.shape.x / bake.size.y;\n  let steepness = bake.size.x * (1.0 + bake.size.w + bake.pits.y);\n  let steps = 16;\n  let stride = max(1, i32(1.0 / texel) / steps);\n  var rise = 0.0;\n  for (var i = 1; i <= steps; i++) {\n    let run = f32(i * stride) * texel;\n    rise = max(rise, (heightAt(t + step * i * stride) - h) * steepness / run);\n  }\n  return atan(rise) / 1.5707963;\n}\n\n// The horizons: along the waves (x) and back, across them (y) and back;\n// the sun is below one where its elevation is less, in the shade.\n@fragment fn fs_horizons(in : Out) -> @location(0) vec4f {\n  let t = vec2i(in.position.xy);\n  let h = heightAt(t);\n  return vec4f(horizonAlong(t, h, vec2i(1, 0)), horizonAlong(t, h, vec2i(-1, 0)),\n               horizonAlong(t, h, vec2i(0, 1)), horizonAlong(t, h, vec2i(0, -1)));\n}\n"

/-- `shaders/sand.wgsl`. -/
def sand : String :=
  "// The sand: the floor, a quadtree of patches (`Reef/Floor.lean`), each\n// the one lattice placed and scaled by its node's record, lifted to the\n// floor's height (`height`, in shaders/frame.wgsl) and, near the camera,\n// its ripples' (`rippleHeight`); lit by a sun from above with the normal\n// found at each pixel, from the floor's slope, the ripples' and the\n// grains', the troughs shaded, the colour speckled by the grains; fading\n// into the background with distance as the grid does.\n\n// The nodes drawn this frame: each its corner nearest the origin (x, z)\n// and its size, in whole leaf cells, the corner's from the cell the eye\n// is in; and its level, 0 the leaves. Whole numbers, so that a vertex two\n// nodes share comes out the same in both, to the last bit.\n@group(0) @binding(1) var<storage, read> nodes : array<vec4f>;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n  @location(0)       relative : vec3f,  // to the camera\n  @location(7)       bary     : vec3f,  // the wireframe's (shaders/wire.wgsl)\n}\n\n// Where `xz`, in the world, is on the ripples' tile: along the waves, and\n// across them, in tiles (`shaders/ripples.wgsl`).\nfn rippleUV(xz : vec2f) -> vec2f {\n  let dir = frame.ripple.xy;\n  return vec2f(dot(xz, dir), dot(xz, vec2f(-dir.y, dir.x))) / frame.tiling.x;\n}\n\n// What the ripples add to the floor's height at `xz`, in the world, for\n// a vertex `dist` from the eye: a crest half their height up, a trough\n// half down, from the tile's mip level smoothed over twice the mesh's\n// cell at that distance (the leaves' within their range, doubling with\n// it), so that the vertices carry what they can and not a sample each\n// of what they cannot, which would be ragged; what is finer than the\n// mesh the normal map keeps.\nfn rippleHeight(xz : vec2f, dist : f32) -> f32 {\n  let texel = frame.tiling.x / f32(textureDimensions(ripples, 0).x);\n  let cell = frame.eye.z * max(1.0, 2.0 * dist / frame.floor.y);\n  let lod = log2(max(1.0, 2.0 * cell / texel));\n  let h = textureSampleLevel(ripples, rippleSampler, rippleUV(xz), lod).r;\n  return (h - 0.5) * frame.ripple.w;\n}\n\n// How much the ripples lift the mesh `dist` from the eye: wholly near it,\n// where the patches are fine enough to carry them; beyond, the normal map\n// carries them alone.\nfn rippleFade(dist : f32) -> f32 {\n  return 1.0 - smoothstep(frame.tiling.y, frame.tiling.z, dist);\n}\n\n// The floor's point at `cellXZ`, in leaf cells from the eye's cell,\n// relative to the camera, as `height` says, and the ripples near the eye.\nfn floorAt(cellXZ : vec2f) -> vec3f {\n  let xz = cellXZ * frame.eye.z - frame.eye.xy;\n  let world = xz + frame.camera.xz;\n  let dist = length(xz);\n  let y = height(world) + rippleHeight(world, dist) * rippleFade(dist);\n  return vec3f(xz.x, y - frame.camera.y, xz.y);\n}\n\n// How far a vertex `dist` from the eye is morphed at level `level`: 0\n// before the level's range's `morph` fraction, 1 a little short of the\n// range (so that a vertex at it is wholly morphed whatever the floats say).\nfn morph(dist : f32, level : f32) -> f32 {\n  let range = frame.floor.y * exp2(level);\n  let start = range * frame.floor.z;\n  let end = range - (range - start) * 0.05;\n  return clamp((dist - start) / (end - start), 0.0, 1.0);\n}\n\n// A lattice vertex of the node `instance` (its record relative to the\n// camera): placed in the node, and, near the node's range, morphed onto\n// its parent's lattice (every other vertex moved onto the one before it),\n// so that the node meets a neighbour at the level above with no crack,\n// and leaves for the level above with no pop. The morph begins at the\n// range's `morph` fraction of the way out, by the vertex's own distance\n// from the eye. The three levels above are morphed too, as a neighbour\n// at those levels would morph the same vertex, so that the two agree\n// wherever they meet, whatever the distances (three, for relief many\n// times the design's, which carries a node's vertices far).\n@vertex fn vs(@location(0) lattice : vec2f,\n              @builtin(vertex_index) index : u32,\n              @builtin(instance_index) instance : u32) -> Out {\n  let node = nodes[instance];\n  let cells = frame.floor.x;\n  // Leaf cells a lattice step: a power of two, exact.\n  let step = node.z / cells;\n  var morphed = lattice;\n  for (var k = 0u; k < 4u; k++) {\n    // The distance from where the vertex is after the levels below: a\n    // vertex moved onto another must go on as that one does.\n    let dist = length(floorAt(node.xy + morphed * step));\n    let s = exp2(f32(k + 1u));\n    morphed = morphed - fract(morphed / s) * s * morph(dist, node.w + f32(k));\n  }\n  var out : Out;\n  out.relative = floorAt(node.xy + morphed * step);\n  out.position = frame.viewProj * vec4f(out.relative, 1.0);\n  out.bary = barycentric(index);\n  return out;\n}\n\n// The grains' tile is small, and would show its repeating a few tile\n// widths off; so it is read through a grid of triangles a few tiles\n// across, each corner of which reads the tile from a place of its own,\n// and the three readings blended by how near the corners are (Heitz and\n// Neyret, \"High-Performance By-Example Noise using a Histogram-\n// Preserving Blending Operator\", 2018): no two triangles show the same\n// part of the tile, and no seam between them. A blend of three is\n// flatter than any one, so what varies is scaled back up by the\n// weights' length: the tilt, which varies about zero, and the\n// brightness, which varies about a half.\nconst grainTriangles = 3.0;  // tile widths across one\n\n// Where `uv`, in tile widths, falls in the grid of triangles: the\n// three corners, and how near each (the barycentric weights).\nfn triangleAt(uv : vec2f) -> mat3x3f {\n  let skewed = mat2x2f(1.0, 0.0, -0.57735027, 1.15470054) * (uv / grainTriangles);\n  let base = floor(skewed);\n  let f = fract(skewed);\n  if (f.x + f.y < 1.0) {\n    return mat3x3f(vec3f(base, 1.0 - f.x - f.y),\n                   vec3f(base + vec2f(1.0, 0.0), f.x),\n                   vec3f(base + vec2f(0.0, 1.0), f.y));\n  }\n  return mat3x3f(vec3f(base + vec2f(1.0, 1.0), f.x + f.y - 1.0),\n                 vec3f(base + vec2f(1.0, 0.0), 1.0 - f.y),\n                 vec3f(base + vec2f(0.0, 1.0), 1.0 - f.x));\n}\n\n// The place a corner `corner` of the grid reads the tile from: an\n// offset of its own, in tile widths.\nfn cornerOffset(corner : vec2f) -> vec2f {\n  let c = vec2i(corner);\n  var h = (u32(c.x) * 0x8da6b343u) ^ (u32(c.y) * 0xd8163841u) ^ 0x3u;\n  h = h ^ (h >> 15u);\n  h = h * 0x2c1b3c6du;\n  h = h ^ (h >> 12u);\n  return vec2f(f32(h & 0xffffu), f32((h >> 16u) & 0xffffu)) / 65535.0;\n}\n\n// The grains' tile at `xz`, in the world, read through the grid of\n// triangles, for a pixel whose footprint is `along` and `across`: the\n// normal, not unit (shorter where the filtering has averaged it), and\n// the brightness. The tilt and the brightness are scaled back up to the\n// tile's contrast; the normal's height is the plain blend, as its\n// length is what is wanted of it.\nfn grainsAt(xz : vec2f, along : vec2f, across : vec2f) -> vec4f {\n  let uv = xz / frame.grain.x;\n  let corners = triangleAt(uv);\n  var sum = vec4f(0.0);\n  var weights = 0.0;\n  for (var i = 0; i < 3; i++) {\n    let corner = corners[i];\n    let read = textureSampleGrad(grains, rippleSampler, uv + cornerOffset(corner.xy),\n                                 along / frame.grain.x, across / frame.grain.x);\n    sum += corner.z * (read - 0.5);\n    weights += corner.z * corner.z;\n  }\n  let scaled = sum / sqrt(weights);\n  return vec4f(scaled.x * 2.0, sum.y * 2.0, scaled.z * 2.0, scaled.w + 0.5);\n}\n\n// Oren and Nayar's diffuse lighting of a rough surface, `sigma2` the\n// square of its roughness (the spread of its facets, in radians), with\n// normal `n`, lit from `l`, seen from `v`: like Lambert's, but a rough\n// surface shows the same from every angle when lit from behind the\n// viewer, and darkens toward the light, as sand does.\nfn roughDiffuse(n : vec3f, l : vec3f, v : vec3f, sigma2 : f32) -> f32 {\n  let nl = max(dot(n, l), 0.0);\n  let nv = max(dot(n, v), 0.0);\n  let a = 1.0 - 0.5 * sigma2 / (sigma2 + 0.33);\n  let b = 0.45 * sigma2 / (sigma2 + 0.09);\n  let s = dot(l, v) - nl * nv;\n  let t = select(1.0, max(nl, nv), s > 0.0);\n  return nl * (a + b * s / max(t, 1e-4));\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let world = toWorld(in.relative);\n  let dist = length(in.relative);\n  let view = in.relative / dist;\n  // The pixel's footprint on the floor: its width square on, and, along\n  // the view, longer as the view slants. Found from the pixel's angle and\n  // the floor's slope, not the screen's differences, which at a crest's\n  // silhouette span the gap to the ripple behind, and would fetch the\n  // tile's mean there: a flat normal, a bright line along every crest.\n  let foot = dist * frame.camera.w;\n  // The floor's slope at this pixel, by differences a footprint wide, at\n  // least a few centimetres: smooth, whatever the tessellation.\n  var slope = floorSlope(world.xz, max(foot, 0.03));\n  let floorNormal = normalize(vec3f(-slope.x, 1.0, -slope.y));\n  let slant = max(abs(dot(floorNormal, view)), 0.02);\n  let ahead = select(vec2f(1.0, 0.0), normalize(view.xz), length(view.xz) > 1e-4);\n  let footAlong = ahead * (foot / slant);\n  let footAcross = vec2f(-ahead.y, ahead.x) * foot;\n  // The ripples' slope, from their tile, filtered to that footprint (so\n  // that far off, where they are finer than a pixel, they average away):\n  // in heights per wavelength along the waves and across, made metres\n  // per metre, and turned to the world's axes.\n  let tile = textureSampleGrad(ripples, rippleSampler, rippleUV(world.xz),\n                               rippleUV(footAlong), rippleUV(footAcross));\n  let along = (tile.gb * 2.0 - 1.0) * 8.0 * frame.ripple.w / frame.ripple.z;\n  let dir = frame.ripple.xy;\n  slope += along.x * dir + along.y * vec2f(-dir.y, dir.x);\n  // The grains' tilt, from their tile over the world's axes, filtered\n  // likewise: where they are finer than the pixel, the normal averages\n  // to flat, and shorter (the roughness they leave, Toksvig's measure,\n  // for the lighting to come), so the tilt fades out of its own accord.\n  let grain = grainsAt(world.xz, footAlong, footAcross);\n  let tilt = grain.xyz;\n  slope += frame.grain.y * vec2f(-tilt.x, -tilt.z) / max(tilt.y, 0.2);\n  let normal = normalize(vec3f(-slope.x, 1.0, -slope.y));\n  // The sand's roughness: its own, grain on grain, and what the\n  // filtering has averaged out of the grains' normal, which is shorter\n  // by that much (Toksvig).\n  let shortened = max(length(tilt), 0.2);\n  let sigma2 = 0.36 + (1.0 - shortened) / shortened;\n  let sun = frame.sun.xyz;\n  // Whether the sun is up over the ripples here: the horizon toward it,\n  // from the four the tile holds, against its elevation; softly, as the\n  // horizons, filtered, are a mean over what is under the pixel.\n  let sunAcross = vec2f(dot(sun.xz, dir), dot(sun.xz, vec2f(-dir.y, dir.x)));\n  let toward = max(vec4f(sunAcross.x, -sunAcross.x, sunAcross.y, -sunAcross.y),\n                   vec4f(0.0));\n  let rims = textureSampleGrad(horizons, rippleSampler, rippleUV(world.xz),\n                               rippleUV(footAlong), rippleUV(footAcross));\n  let horizon = dot(toward, rims) / max(dot(toward, vec4f(1.0)), 1e-4) * 1.5707963;\n  let lit = smoothstep(horizon - 0.15, horizon + 0.15, asin(clamp(sun.y, -1.0, 1.0)));\n  // The sand's colour, speckled by the grains: each its own brightness,\n  // the gaps between them dark; far off, their mean.\n  let sand = vec3f(0.55, 0.47, 0.30) * mix(1.0, 2.0 * grain.a, frame.grain.z);\n  // Lit by the sky as much as it can see, and by the sun where it is up.\n  let cavity = mix(1.0, tile.a, frame.tiling.w);\n  let light = 0.25 * cavity + 0.75 * roughDiffuse(normal, sun, -view, sigma2) * lit;\n  let color = sand * light;\n  let fade = visible(length(in.relative));\n  return vec4f(mix(background, color, fade), 1.0);\n}\n"

/-- `shaders/wire.wgsl`. -/
def wire : String :=
  "// The wireframe: for every material's shader, which the program puts this\n// before, a fragment entry drawing the mesh's edges over its triangles.\n// The triangles are drawn again, with no indices, every corner its own\n// vertex, so that the vertex shader can give each corner its barycentric\n// coordinate (`barycentric`, from the vertex's index, at location 7, which\n// every material's vertex output carries): across a triangle they\n// interpolate to the distances from its edges, and `fwidth` says how far\n// a pixel is, so the edges are lines a pixel and a half wide, anti-aliased,\n// whatever the distance, as the grid's are. Being the same triangles, they\n// are at the same depth as the material's, and pass a test of less or\n// equal. They fade as the triangles shrink on the screen (far off, or\n// fine), gone below a few pixels, where they would pile up opaque: the\n// derivatives say how many pixels a triangle spans.\n\n// Corner `index % 3`'s barycentric coordinate.\nfn barycentric(index : u32) -> vec3f {\n  let corner = index % 3u;\n  return vec3f(f32(corner == 0u), f32(corner == 1u), f32(corner == 2u));\n}\n\n@fragment fn fs_wire(@location(7) bary : vec3f) -> @location(0) vec4f {\n  let width = max(fwidth(bary), vec3f(1e-6));\n  // The distance to the nearest edge, in pixels: a line a pixel wide.\n  let d = bary / width;\n  let edge = min(min(d.x, d.y), d.z);\n  let line = 1.0 - smoothstep(0.3, 1.0, edge);\n  // The triangle's size on the screen, in pixels, about (the mean of its\n  // longest and shortest, as a foreshortened one is long one way): the\n  // lines go as it falls below three pixels, gone at one.\n  let longest = 1.0 / min(min(width.x, width.y), width.z);\n  let shortest = 1.0 / max(max(width.x, width.y), width.z);\n  let size = sqrt(longest * shortest);\n  let alpha = line * smoothstep(1.0, 3.0, size);\n  if (alpha < 0.004) {\n    discard;\n  }\n  return vec4f(0.05, 0.1, 0.45, alpha);\n}\n"

end Reef.Shaders
