import Lake
open Lake DSL System

/-!
A bioluminescent reef, drawn with WebGPU from Lean, natively and in a
browser, through the raw WebGPU bindings (`WebGPURaw`), which this package
requires as any package would: from git, at a release. Building it fetches
what the bindings need (wgpu-native, and SDL3 for the window); the shared
libraries are copied beside the program, which finds them there.

    lake build
    lake exe reef

The shaders are WGSL files in `shaders/`, embedded in the program: the build
writes them into `Reef/Shaders.lean` (generated, not committed) before it
compiles the program, so an edited shader is built in.
-/

package Reef where
  leanOptions  := #[⟨`autoImplicit, false⟩]
  license      := "Apache-2.0 OR MIT"
  licenseFiles := #["LICENSE-APACHE", "LICENSE-MIT"]

require WebGPURaw from git
  "https://github.com/lancelet/webgpu-raw-lean" @ "main"

/--
`Reef/Shaders.lean`, from the WGSL files in `shaders/`: each `name.wgsl` a
string `Reef.Shaders.name`. Written only when it would change, so that
nothing is rebuilt otherwise.
-/
target shaders pkg : FilePath := Job.async do
  let dir := pkg.dir / "shaders"
  let files := ((← dir.readDir).map (·.path)).qsort (·.toString < ·.toString)
    |>.filter (·.extension == some "wgsl")
  let mut text :=
    "-- Generated by the lakefile from shaders/*.wgsl: DO NOT EDIT.\n\n\
    namespace Reef.Shaders\n"
  for file in files do
    let name := file.fileStem.getD "shader"
    text := text ++ s!"\n/-- `shaders/{name}.wgsl`. -/\n\
      def {name} : String :=\n  {(← IO.FS.readFile file).quote}\n"
  text := text ++ "\nend Reef.Shaders\n"
  let out := pkg.dir / "Reef" / "Shaders.lean"
  let old ← if ← out.pathExists then some <$> IO.FS.readFile out
    else pure none
  unless old == some text do
    IO.FS.writeFile out text
  return out

/-- The demo's modules, `Reef.lean` and `Reef/`, the shaders written first. -/
lean_lib Reef where
  needs := #[shaders]

/--
The demo: `lake exe reef [--frames N] [--headless]`. With `--frames N`, it
ends after `N` frames; with `--headless`, it draws with no display, as on
macOS's CI runners (macOS only).
-/
@[default_target]
lean_exe reef where
  root := `Reef.Main
