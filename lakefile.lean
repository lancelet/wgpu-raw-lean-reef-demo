import Lake
open Lake DSL System

/-!
A bioluminescent reef, drawn with WebGPU from Lean, natively and in a
browser, through the raw WebGPU bindings (`WebGPURaw`), which this package
requires as any package would: from git, at their `main`. Building it fetches
what the bindings need (wgpu-native, and SDL3 for the window); the shared
libraries are copied beside the program, which finds them there.

    lake build
    lake exe reef

The shaders are WGSL files in `shaders/`, embedded in the program: the build
writes them into `Reef/Shaders.lean` before it compiles the program, so an
edited shader is built in; likewise the overlay's font, in `fonts/`, into
`Reef/Fonts.lean`, in base64. Those files are committed too: `lake build
Reef` (which the web build runs) reads the library's imports before it
writes them, and a fresh checkout would have none. CI checks the shaders'
is current.
-/

package Reef where
  leanOptions  := #[⟨`autoImplicit, false⟩]
  -- On macOS, the modules' C is compiled for the macOS Lean's own libraries
  -- are built for, whatever shell the build runs in: the linker warns of
  -- every object newer than its target (the Nix shell's, `flake.nix`).
  moreLeancArgs :=
    if System.Platform.isOSX then #["-mmacos-version-min=15.0"] else #[]
  license      := "Apache-2.0 OR MIT"
  licenseFiles := #["LICENSE-APACHE", "LICENSE-MIT"]

require WebGPURaw from git
  "https://github.com/lancelet/webgpu-raw-lean" @ "main"

/--
`Reef/Shaders.lean`, from the WGSL files in `shaders/`: each `name.wgsl` a
string `Reef.Shaders.name`. Written only when it would change, so that
nothing is rebuilt otherwise.
-/
target shaders pkg : FilePath := Job.async do
  let dir := pkg.dir / "shaders"
  let files := ((← dir.readDir).map (·.path)).qsort (·.toString < ·.toString)
    |>.filter (·.extension == some "wgsl")
  let mut text :=
    "-- Generated by the lakefile from shaders/*.wgsl: DO NOT EDIT.\n\n\
    namespace Reef.Shaders\n"
  for file in files do
    let name := file.fileStem.getD "shader"
    text := text ++ s!"\n/-- `shaders/{name}.wgsl`. -/\n\
      def {name} : String :=\n  {(← IO.FS.readFile file).quote}\n"
  text := text ++ "\nend Reef.Shaders\n"
  let out := pkg.dir / "Reef" / "Shaders.lean"
  let old ← if ← out.pathExists then some <$> IO.FS.readFile out
    else pure none
  unless old == some text do
    IO.FS.writeFile out text
  return out

/-- `bytes` in base64 (RFC 4648: the standard alphabet, `=` padding, no
line breaks). -/
def base64 (bytes : ByteArray) : String := Id.run do
  let digits :=
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    |>.toList.toArray
  let digit (v : Nat) : Char := digits[v % 64]!
  let mut out := ""
  let n := bytes.size
  let mut i := 0
  while i + 3 <= n do
    let v := bytes[i]!.toNat <<< 16 ||| bytes[i + 1]!.toNat <<< 8
      ||| bytes[i + 2]!.toNat
    out := out.push (digit (v >>> 18))
    out := out.push (digit (v >>> 12))
    out := out.push (digit (v >>> 6))
    out := out.push (digit v)
    i := i + 3
  if i + 2 == n then
    let v := bytes[i]!.toNat <<< 16 ||| bytes[i + 1]!.toNat <<< 8
    out := out.push (digit (v >>> 18))
    out := out.push (digit (v >>> 12))
    out := out.push (digit (v >>> 6))
    out := out.push '='
  else if i + 1 == n then
    let v := bytes[i]!.toNat <<< 16
    out := out.push (digit (v >>> 18))
    out := out.push (digit (v >>> 12))
    out := out ++ "=="
  return out

/--
`Reef/Fonts.lean`, from the TrueType files in `fonts/`: each `name.ttf` a
string `Reef.Fonts.name` of its bytes in base64 (`Reef.Base64` decodes it),
a hyphen in the name an underscore. Written only when a font is newer than
it, so that nothing is rebuilt otherwise.
-/
target fonts pkg : FilePath := Job.async do
  let dir := pkg.dir / "fonts"
  let files := ((← dir.readDir).map (·.path)).qsort (·.toString < ·.toString)
    |>.filter (·.extension == some "ttf")
  let out := pkg.dir / "Reef" / "Fonts.lean"
  let written ← if ← out.pathExists then some <$> out.metadata else pure none
  let newer ← files.anyM fun file => do
    match written with
    | some w => return (← file.metadata).modified > w.modified
    | none => return true
  if newer then
    let mut text :=
      "-- Generated by the lakefile from fonts/*.ttf: DO NOT EDIT.\n\n\
      namespace Reef.Fonts\n"
    for file in files do
      let name := (file.fileStem.getD "font").replace "-" "_"
      text := text ++ s!"\n/-- `fonts/{name}.ttf`, in base64. -/\n\
        def {name} : String :=\n  {(base64 (← IO.FS.readBinFile file)).quote}\n"
    text := text ++ "\nend Reef.Fonts\n"
    IO.FS.writeFile out text
  return out

/-- The demo's modules, `Reef.lean` and `Reef/`, the shaders and the fonts
written first. -/
lean_lib Reef where
  needs := #[shaders, fonts]

/--
The demo: `lake exe reef [--frames N] [--windowed] [--headless]
[--screenshot FILE] [--camera X,Y,Z,YAW,PITCH]`. With `--frames N`, it ends
after `N` frames; with `--windowed`, it draws in a window rather than
filling the screen; with `--headless`, it draws with no display, as on
macOS's CI runners (macOS only); with `--screenshot FILE`, it draws one
frame into that file, a PPM image, and ends; with `--camera`, the camera
starts there.
-/
@[default_target]
lean_exe reef where
  root := `Reef.Main
