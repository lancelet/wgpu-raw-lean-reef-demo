/-- `shaders/background.wgsl`. -/
def background : String :=
  "// The water behind everything: one triangle over the whole target,\n// each pixel the water's colour along its own direction (`water`, in\n// shaders/frame.wgsl), drawn first, under the floor, where nothing else\n// is. For the time being the surface is not drawn: looking up shows the\n// water brightening toward it.\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let ndc = (in.position.xy / frame.screen.xy) * 2.0 - 1.0;\n  let dir = normalize(frame.forward.xyz + frame.right.xyz * (ndc.x * frame.right.w)\n                      - frame.up.xyz * (ndc.y * frame.up.w));\n  return vec4f(water(dir), 1.0);\n}\n"

/-- `shaders/blur.wgsl`. -/
def blur : String :=
  "// A texture blurred a little, in one direction at a time (`Reef/Caustics.lean`):\n// the caustics, by the sun's own width, which no point of the surface\n// can focus finer than. Five taps, a Gaussian about a texel wide; the\n// texture repeating, as the tile does.\n\n@group(0) @binding(0) var source : texture_2d<f32>;\n@group(0) @binding(1) var wrap : sampler;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\nfn blurred(uv : vec2f, step : vec2f) -> vec4f {\n  return textureSampleLevel(source, wrap, uv, 0.0) * 0.4\n    + (textureSampleLevel(source, wrap, uv + step, 0.0)\n       + textureSampleLevel(source, wrap, uv - step, 0.0)) * 0.24\n    + (textureSampleLevel(source, wrap, uv + 2.0 * step, 0.0)\n       + textureSampleLevel(source, wrap, uv - 2.0 * step, 0.0)) * 0.06;\n}\n\n@fragment fn fs_x(in : Out) -> @location(0) vec4f {\n  let size = vec2f(textureDimensions(source));\n  return blurred(in.position.xy / size, vec2f(1.5 / size.x, 0.0));\n}\n\n@fragment fn fs_y(in : Out) -> @location(0) vec4f {\n  let size = vec2f(textureDimensions(source));\n  return blurred(in.position.xy / size, vec2f(0.0, 1.5 / size.y));\n}\n"

/-- `shaders/caustics.wgsl`. -/
def caustics : String :=
  "// The caustics for one moment of the sea's surface (`Reef/Caustics.lean`):\n// the sun's light through the surface's waves, as it lands on the floor.\n// A grid over one tile of the surface (and a margin, for what lands in\n// the tile from beyond it) is drawn as triangles into a texture over the\n// tile, each vertex carried straight down its refracted ray to the\n// floor; each vertex's brightness is how much surface lands on how much\n// floor about it (the landing's Jacobian, by differences), so that where\n// the surface's curvature draws the rays together the light is bright,\n// unboundedly so at a fold, and where it spreads them, dim; and where\n// the surface folds over itself the triangles pile up and add. Three\n// instances, the water's refractive index a little different for each,\n// red, green and blue, so the brightest lines fringe with colour, as\n// they do. The sun straight down: the sand projects the pattern along\n// the sun it has.\n//\n// The surface is `field` (shaders/ocean.wgsl): the height and the slopes\n// at each point of a grid over the tile, read between the points.\n\nconst N = 256u;\n// The water's refractive index for green; how far red's and blue's lie\n// either side of it is the bake's `dispersion`.\nconst index = 1.333;\n// The light at a fold, which the maths has unbounded; the texture holds\n// the light over this, 0 to 1.\nconst brightest = 8.0;\n\nstruct Bake {\n  // The tile's width, in metres; the surface's height above the floor;\n  // the grid drawn, quads a side; its margin beyond the tile, in metres;\n  // how far the water's index for red and for blue lie either side of\n  // green's (0.006 in truth).\n  tile       : f32,\n  depth      : f32,\n  grid       : u32,\n  margin     : f32,\n  dispersion : f32,\n  pad0       : f32,\n  pad1       : f32,\n  pad2       : f32,\n}\n\n@group(0) @binding(0) var<uniform> bake : Bake;\n@group(0) @binding(1) var<storage, read> field : array<vec4f>;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n  @location(0) light : f32,\n  @location(1) @interpolate(flat) channel : u32,\n}\n\n// The surface at `p` (the world's xz), between the grid's points: the\n// height, and the slope along x and z.\nfn surface(p : vec2f) -> vec3f {\n  let uv = p / bake.tile * f32(N);\n  let i = vec2i(floor(uv));\n  let f = fract(uv);\n  let n = i32(N);\n  let i00 = vec2u(vec2i((i.x % n + n) % n, (i.y % n + n) % n));\n  let i11 = (i00 + vec2u(1u)) % N;\n  let f00 = field[i00.y * N + i00.x].xyz;\n  let f10 = field[i00.y * N + i11.x].xyz;\n  let f01 = field[i11.y * N + i00.x].xyz;\n  let f11 = field[i11.y * N + i11.x].xyz;\n  return mix(mix(f00, f10, f.x), mix(f01, f11, f.x), f.y);\n}\n\n// Where the sun's ray, straight down, through the surface at `p` lands\n// on the floor, the water's index `eta` (air's over it).\nfn landing(p : vec2f, eta : f32) -> vec2f {\n  let s = surface(p);\n  let normal = normalize(vec3f(-s.y, 1.0, -s.z));\n  var ray = refract(vec3f(0.0, -1.0, 0.0), normal, eta);\n  if (length(ray) < 0.5) { ray = vec3f(0.0, -1.0, 0.0); }\n  return p + ray.xz * (bake.depth - s.x) / max(-ray.y, 0.05);\n}\n\n// The grid's vertices, `grid + 1` a side over the tile and its margin,\n// indexed as the floor's lattice is (`Reef.latticeIndices`).\n@vertex fn vs(@builtin(vertex_index) v : u32,\n              @builtin(instance_index) instance : u32) -> Out {\n  let grid = bake.grid;\n  let cx = v % (grid + 1u);\n  let cz = v / (grid + 1u);\n  let span = bake.tile + 2.0 * bake.margin;\n  let step = span / f32(grid);\n  let p = vec2f(f32(cx), f32(cz)) * step - bake.margin;\n  let eta = 1.0 / (index + bake.dispersion * (f32(instance) - 1.0));\n  let here = landing(p, eta);\n  // How much floor a patch of surface about `p` lands on: the landing's\n  // Jacobian, by differences a third of a step on; the light is the\n  // surface's share of it, the inverse.\n  let h = step / 3.0;\n  let ddx = (landing(p + vec2f(h, 0.0), eta) - here) / h;\n  let ddz = (landing(p + vec2f(0.0, h), eta) - here) / h;\n  let spread = abs(ddx.x * ddz.y - ddx.y * ddz.x);\n  var out : Out;\n  out.position = vec4f(here.x / bake.tile * 2.0 - 1.0, 1.0 - here.y / bake.tile * 2.0,\n                       0.0, 1.0);\n  out.light = min(1.0 / max(spread, 1e-4), brightest) / brightest;\n  out.channel = instance;\n  return out;\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  return vec4f(select(0.0, in.light, in.channel == 0u),\n               select(0.0, in.light, in.channel == 1u),\n               select(0.0, in.light, in.channel == 2u), 0.0);\n}\n"

/-- `shaders/frame.wgsl`. -/
def frame : String :=
  "// The frame's uniforms, as every shader reads them, put before each\n// (`Reef/Render.lean`): as `Reef.frameBytes` encodes them, 432 bytes.\n\n// Everything is drawn relative to the camera, which is at the origin of\n// `viewProj`; `camera` is where it is in the world, for what is a function\n// of the world's coordinates.\nstruct Frame {\n  viewProj : mat4x4f,\n  camera   : vec4f,  // where the camera is in the world; the angle a pixel subtends, in radians\n  grid     : vec4f,  // spacing, major, extent, fade\n  floor    : vec4f,  // a patch's cells a side, the leaves' range, the morph fraction, the height's amplitude\n  eye      : vec4f,  // the camera's place in its leaf cell (x, z), the cell's size; w unused\n  ripple   : vec4f,  // the waves' direction (x, z), the ripples' wavelength, their height, in metres\n  tiling   : vec4f,  // the ripples' tile, in metres; the distance their displacement fades from, and to; the cavity's strength\n  grain    : vec4f,  // the grains' tile, in metres; their relief; their speckle; w unused\n  sun      : vec4f,  // where the sun's light comes from: unit; w unused\n  right    : vec4f,  // the camera's right, and the tangent of half the view's width\n  up       : vec4f,  // the camera's up, and the tangent of half the view's height\n  forward  : vec4f,  // the camera's forward; w unused\n  screen   : vec4f,  // the target's width and height, in pixels; the time, in seconds; w unused\n  water    : vec4f,  // the surface's height above the floor's zero, in metres; the caustics' strength; z, w unused\n  extinct  : vec4f,  // how fast the water takes each colour, per metre; w unused\n  horizon  : vec4f,  // the water's colour seen level, far off\n  zenith   : vec4f,  // ... seen up, toward the surface\n  deep     : vec4f,  // ... seen down, into the depths\n  sunlight : vec4f,  // the sun's light at the floor\n  skylight : vec4f,  // the sky's, from all above\n  caustic  : vec4f,  // the caustics' loop: its tile, in metres; its length, in seconds; its moments, the layers; w unused\n  surface  : vec4f,  // the surface's grid, cells a side, and its reach from the camera, in metres; the nearest and farthest the camera sees\n  shaft    : vec4f,  // the light in the water: its strength; the steps a pixel marches; how far, in metres; and the frame's exposure (shaders/resolve.wgsl)\n  swell    : vec4f,  // the swell: its height, trough to crest, in metres; its period, in seconds; how far its waves' headings spread about the ripples', in radians; w unused\n}\n\n@group(0) @binding(0) var<uniform> frame : Frame;\n\n// The ripples' tile (`shaders/ripples.wgsl`) and the grains'\n// (`shaders/grains.wgsl`), with their mip levels, and how they are\n// sampled: repeating, filtered by the pixel's footprint.\n@group(0) @binding(2) var ripples : texture_2d<f32>;\n@group(0) @binding(3) var rippleSampler : sampler;\n@group(0) @binding(4) var grains : texture_2d_array<f32>;\n@group(0) @binding(5) var horizons : texture_2d<f32>;\n// The caustics, baked as a loop (`Reef/Caustics.lean`): a layer a moment,\n// over one tile of the surface, the light over its brightest.\n@group(0) @binding(6) var caustics : texture_2d_array<f32>;\nconst causticBrightest = 8.0;\n// The sea's surface at this moment (`shaders/ocean.wgsl`, evolved each\n// frame): the height and the slopes at each point of a grid over one\n// tile, `seaPoints` a side.\n@group(0) @binding(7) var<storage, read> sea : array<vec4f>;\nconst seaPoints = 256u;\n\n// The swell at `xz`, in the world, at time `t`: what is left of the\n// ocean's long waves over the reef's crest, a slow heave of the surface\n// that the chop rides on. Three waves of periods that share no multiple,\n// headed a little apart about the waves' direction (the ripples'), each\n// swelling and fading over a minute or so out of step with the others,\n// so that sets come and go and nothing repeats; at the speed shallow\n// water gives a long wave, the square root of gravity times the depth.\n// The height, and the slope along x and z. (Not in the caustics: at this\n// depth a wave so long focuses nothing.)\nconst tau = 6.283185307;\nconst swellPeriods = array<f32, 3>(1.0, 1.21, 0.83);\nconst swellShares = array<f32, 3>(0.5, 0.3, 0.2);\nconst swellHeadings = array<f32, 3>(0.0, 1.0, -0.7);\nconst swellPhases = array<f32, 3>(0.0, 2.1, 4.4);\nconst swellSets = array<f32, 3>(73.0, 101.0, 59.0);\nconst gravity = 9.81;\n\nfn swellWave(i : i32, xz : vec2f, t : f32) -> vec4f {\n  let depth = frame.water.x;\n  let dir = frame.ripple.xy;\n  let period = frame.swell.y * swellPeriods[i];\n  let omega = tau / period;\n  let k = omega / sqrt(gravity * depth);\n  // The set: the wave's amplitude swelling and fading, slowly.\n  let swelling = 0.7 + 0.3 * sin(t * tau / swellSets[i] + swellPhases[i] * 1.7);\n  let amplitude = frame.swell.x * 0.5 * swellShares[i] * swelling;\n  let angle = frame.swell.z * swellHeadings[i];\n  let heading = vec2f(dir.x * cos(angle) - dir.y * sin(angle),\n                      dir.x * sin(angle) + dir.y * cos(angle));\n  let phase = k * dot(heading, xz) - omega * t + swellPhases[i];\n  return vec4f(amplitude, k, phase, 0.0);\n}\n\nfn swellAt(xz : vec2f, t : f32) -> vec3f {\n  var height = 0.0;\n  var slope = vec2f(0.0);\n  let dir = frame.ripple.xy;\n  for (var i = 0; i < 3; i++) {\n    let w = swellWave(i, xz, t);\n    let angle = frame.swell.z * swellHeadings[i];\n    let heading = vec2f(dir.x * cos(angle) - dir.y * sin(angle),\n                        dir.x * sin(angle) + dir.y * cos(angle));\n    height += w.x * sin(w.z);\n    slope += w.x * w.y * cos(w.z) * heading;\n  }\n  return vec3f(height, slope);\n}\n\n// The surge: the water's sway along the floor under the swell at `xz`,\n// at time `t`, in metres a second, for what lives there to follow: in\n// shallow water a wave's orbit flattens to a back-and-forth, its speed\n// the amplitude times the frequency over the wave number times the\n// depth.\nfn surgeAt(xz : vec2f, t : f32) -> vec2f {\n  var surge = vec2f(0.0);\n  let depth = frame.water.x;\n  let dir = frame.ripple.xy;\n  for (var i = 0; i < 3; i++) {\n    let w = swellWave(i, xz, t);\n    let angle = frame.swell.z * swellHeadings[i];\n    let heading = vec2f(dir.x * cos(angle) - dir.y * sin(angle),\n                        dir.x * sin(angle) + dir.y * cos(angle));\n    let omega = tau / (frame.swell.y * swellPeriods[i]);\n    surge += w.x * omega / (w.y * depth) * sin(w.z) * heading;\n  }\n  return surge;\n}\n\n// How far the swell has carried the surface's water sideways at `xz`,\n// at time `t`, in metres: the surge's sway, summed, which in shallow\n// water is the wave's amplitude over its wave number times the depth,\n// half a metre for a lagoon's swell. The chop rides on the water, so\n// its caustics slide back and forth on the floor with each wave.\nfn swellDriftAt(xz : vec2f, t : f32) -> vec2f {\n  var drift = vec2f(0.0);\n  let depth = frame.water.x;\n  let dir = frame.ripple.xy;\n  for (var i = 0; i < 3; i++) {\n    let w = swellWave(i, xz, t);\n    let angle = frame.swell.z * swellHeadings[i];\n    let heading = vec2f(dir.x * cos(angle) - dir.y * sin(angle),\n                        dir.x * sin(angle) + dir.y * cos(angle));\n    drift += w.x / (w.y * depth) * cos(w.z) * heading;\n  }\n  return drift;\n}\n\n// The sea's surface at `xz`, in the world, between the grid's points,\n// at this moment: its height, and its slope along x and z; the swell\n// under it.\nfn seaAt(xz : vec2f) -> vec3f {\n  let uv = xz / frame.caustic.x * f32(seaPoints);\n  let i = vec2i(floor(uv));\n  let f = fract(uv);\n  let n = i32(seaPoints);\n  let i00 = vec2u(vec2i((i.x % n + n) % n, (i.y % n + n) % n));\n  let i11 = (i00 + vec2u(1u)) % seaPoints;\n  let f00 = sea[i00.y * seaPoints + i00.x].xyz;\n  let f10 = sea[i00.y * seaPoints + i11.x].xyz;\n  let f01 = sea[i11.y * seaPoints + i00.x].xyz;\n  let f11 = sea[i11.y * seaPoints + i11.x].xyz;\n  return mix(mix(f00, f10, f.x), mix(f01, f11, f.x), f.y)\n    + swellAt(xz, frame.screen.z);\n}\n\n// The water, looking along `dir` (unit) into it with nothing in the\n// way: the horizon's colour level, brighter up toward the surface,\n// darker down.\nfn water(dir : vec3f) -> vec3f {\n  let up = smoothstep(-0.05, 0.6, dir.y);\n  let down = smoothstep(0.05, -0.5, dir.y);\n  return mix(mix(frame.horizon.rgb, frame.zenith.rgb, up), frame.deep.rgb, down);\n}\n\n// `colour`, seen through the water at `relative` from the camera: what\n// the water has not taken of it, and the water's own light scattered in\n// along the way, each colour at its own rate.\nfn fogged(colour : vec3f, relative : vec3f) -> vec3f {\n  let dist = length(relative);\n  let through = exp(-frame.extinct.rgb * dist);\n  return mix(water(relative / max(dist, 1e-4)), colour, through);\n}\n\n// How much of something `dist` from the camera shows, the rest fog: for\n// what fades by an alpha (the overlays).\nfn visible(dist : f32) -> f32 {\n  return exp(-dist / frame.grid.w);\n}\n\n// Where `relative`, a point relative to the camera, is in the world.\nfn toWorld(relative : vec3f) -> vec3f {\n  return relative + frame.camera.xyz;\n}\n\n// A gradient at the lattice point `p`, by a hash of its integer\n// coordinates (an integer hash, not a sine's, which fails far from the\n// origin): a direction, not unit.\nfn gradient(p : vec2i) -> vec2f {\n  var h = (u32(p.x) * 0x8da6b343u) ^ (u32(p.y) * 0xd8163841u);\n  h = h ^ (h >> 15u);\n  h = h * 0x2c1b3c6du;\n  h = h ^ (h >> 12u);\n  let a = f32(h & 0xffffu) / 65535.0;\n  let b = f32((h >> 16u) & 0xffffu) / 65535.0;\n  return vec2f(a, b) * 2.0 - 1.0;\n}\n\n// Gradient noise at `p`: smooth, about -1 to 1, a feature a unit wide.\nfn noise(p : vec2f) -> f32 {\n  let i = vec2i(floor(p));\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  let a = dot(gradient(i), f);\n  let b = dot(gradient(i + vec2i(1, 0)), f - vec2f(1.0, 0.0));\n  let c = dot(gradient(i + vec2i(0, 1)), f - vec2f(0.0, 1.0));\n  let d = dot(gradient(i + vec2i(1, 1)), f - vec2f(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\n\n// The floor's height at `xz`, in the world: the large-scale elevation,\n// four octaves of noise, from fifty metres across to two and a half, the\n// mounds and hollows of a back-reef's sand, a metre and a half of relief\n// in all at an amplitude of 1; and on that the sand waves and hummocks,\n// a couple of metres across and under one, some centimetres high, the\n// waves drawn out along the ripples' crests (across the waves'\n// direction), as sand waves lie (`Reef.Floor.relief` bounds the whole).\n// The ripples are on top of this (`shaders/sand.wgsl`).\nfn height(xz : vec2f) -> f32 {\n  let dir = frame.ripple.xy;\n  let along = vec2f(dot(xz, dir), dot(xz, vec2f(-dir.y, dir.x)));\n  return frame.floor.w * (0.6 * noise(xz / 40.0) + 0.45 * noise(xz / 13.0 + 7.0)\n                          + 0.25 * noise(xz / 5.0 + 3.0)\n                          + 0.12 * noise(xz / 2.5 + 11.0))\n       + 0.1 * noise(along / vec2f(1.6, 3.2) + 5.0)\n       + 0.025 * noise(xz / 0.7 + 9.0);\n}\n\n// The floor's slope at `xz`, in the world (the height's rise along x and\n// along z), from the height a step `e` either side.\nfn floorSlope(xz : vec2f, e : f32) -> vec2f {\n  let dx = height(xz + vec2f(e, 0.0)) - height(xz - vec2f(e, 0.0));\n  let dz = height(xz + vec2f(0.0, e)) - height(xz - vec2f(0.0, e));\n  return vec2f(dx, dz) / (2.0 * e);\n}\n"

/-- `shaders/grains.wgsl`. -/
def grains : String :=
  "// The grains' tile, baked once at the start (`Reef/Grains.lean`): the\n// sand's grains, a few centimetres of them, as a texture that repeats.\n// Each texel: the normal of the grains' surface, as (normal / 2 + 0.5),\n// and its brightness, 0.5 the sand's own colour, darker in the gaps\n// between grains, which see less light, and on dark grains, brighter on\n// shell. `shaders/sand.wgsl` reads them.\n//\n// The grains are spheres, a couple to each cell of a grid a grain and a\n// half wide, placed at random in it, of sizes spread three to one about\n// the grain's, most in the middle (a reef's sand is poorly sorted, being\n// broken shell and coral): the surface is the highest of them at each\n// point, a packed bed. Among them, coarse grains, a few times the size,\n// here and there; and fragments (shell and the like): flatter domes,\n// bigger still, one to some of the cells of a coarser grid, lying on the\n// bed. The bed itself rises and falls a little over a few\n// millimetres, the sand's own unevenness between the grains and the\n// ripples, which shows as roughness from a metre or two off, where the\n// grains themselves have averaged away; and is a little darker in its\n// hollows. The grids and the noise are whole numbers of cells across\n// the tile, so the tile repeats.\n\nstruct Bake {\n  // The tile's texels a side; a grain's diameter, and a fragment's, in\n  // texels; how many of the fragments' cells hold one, 0 to 1.\n  grain  : vec4f,\n  // Whether this layer has the traces (1) or not (0); y, z, w unused.\n  traces : vec4f,\n}\n\n@group(0) @binding(0) var<uniform> bake : Bake;\n\nconst tau = 6.283185307;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n// One triangle over the whole target; the fragment's position says where.\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\n// A number in [0, 1) from `seed`, the `n`th of its sequence.\nfn rand(seed : u32, n : u32) -> f32 {\n  var h = seed + n * 0x9e3779b9u;\n  h = h ^ (h >> 16u);\n  h = h * 0x7feb352du;\n  h = h ^ (h >> 15u);\n  h = h * 0x846ca68bu;\n  h = h ^ (h >> 16u);\n  return f32(h & 0xffffffu) / 16777216.0;\n}\n\n// The seed of the cell `cell` of a grid `n` wide over the tile, the grid\n// repeating with it, salted by `salt`.\nfn cellSeed(cell : vec2i, n : i32, salt : u32) -> u32 {\n  let wrapped = ((cell % n) + n) % n;\n  return (u32(wrapped.x) * 0x8da6b343u) ^ (u32(wrapped.y) * 0xd8163841u) ^ salt;\n}\n\n// A gradient at the lattice point `p` of a lattice `period` wide, which\n// repeats: a direction, not unit.\nfn gradient(p : vec2i, period : i32) -> vec2f {\n  var h = cellSeed(p, period, 0x7u);\n  h = h ^ (h >> 15u);\n  h = h * 0x2c1b3c6du;\n  h = h ^ (h >> 12u);\n  let a = f32(h & 0xffffu) / 65535.0;\n  let b = f32((h >> 16u) & 0xffffu) / 65535.0;\n  return vec2f(a, b) * 2.0 - 1.0;\n}\n\n// Gradient noise at `p`, repeating every `period`: smooth, about -1 to 1,\n// a feature a unit wide.\nfn noise(p : vec2f, period : i32) -> f32 {\n  let i = vec2i(floor(p));\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  let a = dot(gradient(i, period), f);\n  let b = dot(gradient(i + vec2i(1, 0), period), f - vec2f(1.0, 0.0));\n  let c = dot(gradient(i + vec2i(0, 1), period), f - vec2f(0.0, 1.0));\n  let d = dot(gradient(i + vec2i(1, 1), period), f - vec2f(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 1.4;\n}\n\n// The bed's unevenness at `p`, in texels: two octaves of noise, eight\n// and four features across the tile, about -1 to 1.\nfn unevenness(p : vec2f) -> f32 {\n  let uv = p / bake.grain.x;\n  return 0.6 * noise(uv * 8.0 + 3.0, 8) + 0.4 * noise(uv * 4.0 + 11.0, 4);\n}\n\n// A grain's brightness, from its seed: most a little darker or lighter\n// than the sand, a few dark (basalt, say), a few bright (shell); a\n// fragment's more often one or the other.\nfn brightnessOf(seed : u32, fragment : bool) -> f32 {\n  let kind = rand(seed, 3u);\n  let dark = select(0.06, 0.3, fragment);\n  let bright = select(0.1, 0.6, fragment);\n  if (kind < dark) { return 0.15 + 0.15 * rand(seed, 4u); }\n  if (kind < bright) { return 0.8 + 0.2 * rand(seed, 4u); }\n  return 0.4 + 0.3 * rand(seed, 4u);\n}\n\n// The surface of a bed of domes at `p`, in texels: the domes `perCell`\n// to each cell of a grid of cells `cell` texels wide, `n` across the\n// tile, each placed at random in its cell, of radius `radius` of the\n// cell at the middle of a spread of sizes `spread` to 1 from smallest to\n// largest (most in the middle, a few at the ends: the sand's sorting,\n// poor for a reef's broken shell and coral), `squash` as high as it is\n// wide (1 a sphere), drawn out along a direction of its own by up to\n// `stretch` (0 round), each there with chance `chance`; seeds salted by\n// `salt`. The height, in texels, of the highest dome at `p` (0 off them\n// all), and its brightness (the gaps' if none).\nfn bedAt(p : vec2f, cell : f32, n : i32, perCell : u32, radius : f32,\n         spread : f32, squash : f32, stretch : f32, chance : f32,\n         salt : u32) -> vec2f {\n  let base = vec2i(floor(p / cell));\n  var best = vec2f(0.0, 0.2);\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let c = base + vec2i(i, j);\n      for (var k = 0u; k < perCell; k++) {\n        let seed = cellSeed(c, n, salt + k * 0x9e3779b9u);\n        if (rand(seed, 5u) >= chance) { continue; }\n        let centre = (vec2f(c) + vec2f(rand(seed, 0u), rand(seed, 1u))) * cell;\n        // Two draws summed: a peak in the middle, in the log of the size.\n        let r = cell * radius * pow(spread, 0.5 * (rand(seed, 2u) + rand(seed, 8u) - 1.0));\n        // Narrowed across its own direction: an ellipse, of the radius\n        // along it.\n        let angle = tau * rand(seed, 6u);\n        let along = vec2f(cos(angle), sin(angle));\n        let narrow = 1.0 / (1.0 - stretch * rand(seed, 7u));\n        let d = p - centre;\n        let e = vec2f(dot(d, along), dot(d, vec2f(-along.y, along.x)) * narrow);\n        let under = r * r - dot(e, e);\n        if (under > 0.0) {\n          let h = squash * sqrt(under);\n          if (h > best.x) { best = vec2f(h, brightnessOf(seed, salt == 0x2u)); }\n        }\n      }\n    }\n  }\n  return best;\n}\n\n// The traces of what lives in the sand, at `p`, in texels: what they add\n// to the height, and how they shade. Holes, a few millimetres across,\n// each with a rim of what was dug out, dark within; castings, the coils\n// a worm leaves, a chain of little mounds along a curve; and scrapes,\n// short shallow grooves. Each scattered sparsely over cells of its own\n// grid, repeating with the tile.\nfn tracesAt(p : vec2f) -> vec2f {\n  let texels = bake.grain.x;\n  let grain = bake.grain.y;\n  var height = 0.0;\n  var shade = 1.0;\n  // In patches: here many, there none, a field of noise over the tile\n  // saying which, three features across it; each kind its own.\n  // Varying over the tile a little; where the traces are at all is the\n  // sand's to say (shaders/sand.wgsl), in colonies of a few ripples.\n  let uv = p / texels * 3.0;\n  let holesHere = smoothstep(-0.3, 0.3, noise(uv + 2.0, 3));\n  let castsHere = smoothstep(-0.2, 0.4, noise(uv + 23.0, 3));\n  let scrapesHere = smoothstep(-0.3, 0.3, noise(uv + 41.0, 3));\n  // Holes, in cells of forty grains, one to a third of them.\n  let holeCells = i32(round(texels / (grain * 40.0)));\n  let holeCell = texels / f32(holeCells);\n  var base = vec2i(floor(p / holeCell));\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let c = base + vec2i(i, j);\n      let seed = cellSeed(c, holeCells, 0x4u);\n      if (rand(seed, 0u) >= 0.35 * holesHere) { continue; }\n      let centre = (vec2f(c) + vec2f(rand(seed, 1u), rand(seed, 2u))) * holeCell;\n      // Mostly small, a few large: the square of a draw.\n      let size = rand(seed, 3u);\n      let r = grain * (2.0 + 10.0 * size * size);\n      let d = length(p - centre) / r;\n      if (d < 1.0) {\n        height -= grain * 2.0 * (1.0 - d * d);\n        shade *= 0.55 + 0.45 * d;\n      } else if (d < 1.8) {\n        height += grain * 0.8 * (1.0 - abs(d - 1.4) / 0.4);\n      }\n    }\n  }\n  // Castings, in cells of fifty grains, one to a quarter: eight mounds\n  // along a curve that turns as it goes.\n  let castCells = i32(round(texels / (grain * 50.0)));\n  let castCell = texels / f32(castCells);\n  base = vec2i(floor(p / castCell));\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let c = base + vec2i(i, j);\n      let seed = cellSeed(c, castCells, 0x5u);\n      if (rand(seed, 0u) >= 0.25 * castsHere) { continue; }\n      var at = (vec2f(c) + vec2f(rand(seed, 1u), rand(seed, 2u))) * castCell;\n      var angle = tau * rand(seed, 3u);\n      let turn = 0.9 * (rand(seed, 4u) - 0.5);\n      let r = grain * 1.6;\n      for (var k = 0u; k < 8u; k++) {\n        let d = length(p - at) / r;\n        if (d < 1.0) { height = max(height, grain * 1.2 * sqrt(1.0 - d * d)); }\n        angle += turn + 0.6 * (rand(seed, 5u + k) - 0.5);\n        at += vec2f(cos(angle), sin(angle)) * r * 1.4;\n      }\n    }\n  }\n  // Scrapes, in cells of forty grains, one to a quarter: a groove along\n  // a short line, a grain deep.\n  let scrapeCells = i32(round(texels / (grain * 40.0)));\n  let scrapeCell = texels / f32(scrapeCells);\n  base = vec2i(floor(p / scrapeCell));\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let c = base + vec2i(i, j);\n      let seed = cellSeed(c, scrapeCells, 0x6u);\n      if (rand(seed, 0u) >= 0.25 * scrapesHere) { continue; }\n      let centre = (vec2f(c) + vec2f(rand(seed, 1u), rand(seed, 2u))) * scrapeCell;\n      let angle = tau * rand(seed, 3u);\n      let along = vec2f(cos(angle), sin(angle));\n      let half = grain * (6.0 + 8.0 * rand(seed, 4u));\n      let d = p - centre;\n      let u = clamp(dot(d, along), -half, half);\n      let off = length(d - along * u) / (grain * 1.2);\n      let end = 1.0 - smoothstep(0.7, 1.0, abs(dot(d, along)) / half);\n      if (off < 1.0) { height -= grain * (1.0 - off * off) * end; }\n    }\n  }\n  return vec2f(height, shade);\n}\n\n// The grains' surface at `p`, in texels: the bed of grains, and the\n// fragments lying on it, in height (texels) and brightness; the bed on\n// its unevenness, a grain's diameter of it, darker in the hollows; and\n// the traces of what lives in it.\nfn surfaceAt(p : vec2f) -> vec2f {\n  let texels = bake.grain.x;\n  // The grains' cells a grain and a half wide, two grains to each, so\n  // that their spacing is no lattice; the coarse grains' cells three\n  // wide, one to some; the fragments' a fragment wide, one to a few.\n  let grainCells = i32(round(texels / (bake.grain.y * 1.5)));\n  let grainCell = texels / f32(grainCells);\n  let coarseCells = i32(round(texels / (bake.grain.y * 3.0)));\n  let coarseCell = texels / f32(coarseCells);\n  let fragmentCells = i32(round(texels / bake.grain.z));\n  let fragmentCell = texels / f32(fragmentCells);\n  let fine = bedAt(p, grainCell, grainCells, 2u, 0.4, 3.0, 1.0, 0.2, 1.0, 0x1u);\n  let coarse = bedAt(p, coarseCell, coarseCells, 1u, 0.45, 2.5, 0.9, 0.3, 0.5, 0x3u);\n  let grains = select(fine, coarse, coarse.x > fine.x);\n  var fragments = bedAt(p, fragmentCell, fragmentCells, 1u, 0.4, 2.0, 0.3, 0.5,\n                        bake.grain.w, 0x2u);\n  // A fragment lies on the bed, a grain's height up.\n  if (fragments.x > 0.0) { fragments.x += bake.grain.y * 0.5; }\n  let uneven = unevenness(p);\n  let surface = select(grains, fragments, fragments.x > grains.x);\n  var traces = tracesAt(p);\n  if (bake.traces.x < 0.5) { traces = vec2f(0.0, 1.0); }\n  return vec2f(surface.x + uneven * bake.grain.y + traces.x,\n               surface.y * (1.0 + 0.2 * uneven) * traces.y);\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let p = in.position.xy;\n  let here = surfaceAt(p);\n  let sx = (surfaceAt(p + vec2f(1.0, 0.0)).x - surfaceAt(p - vec2f(1.0, 0.0)).x) / 2.0;\n  let sy = (surfaceAt(p + vec2f(0.0, 1.0)).x - surfaceAt(p - vec2f(0.0, 1.0)).x) / 2.0;\n  let normal = normalize(vec3f(-sx, 1.0, -sy));\n  return vec4f(normal * 0.5 + 0.5, here.y);\n}\n"

/-- `shaders/grid.wgsl`. -/
def grid : String :=
  "// The grid: a square at the world's height 0, as far as the grid's extent, with a grid\n// of lines on it, a line every spacing and a brighter one every major\n// lines, the x and z axes in colour, fading with distance from the camera.\n// Drawn as two triangles over the floor, the lines found in the fragment\n// shader, a pixel wide whatever the distance, and blended over by their\n// coverage: nothing but the lines shows.\n\nstruct Out {\n  @builtin(position) position : vec4f,\n  @location(0)       relative : vec3f,  // to the camera\n}\n\n// The square around the camera, at the world's height 0.\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  var corners = array<vec2f, 6>(\n    vec2f(-1.0, -1.0), vec2f(1.0, -1.0), vec2f(-1.0, 1.0),\n    vec2f(-1.0, 1.0), vec2f(1.0, -1.0), vec2f(1.0, 1.0));\n  let c = corners[i] * frame.grid.z;\n  var out : Out;\n  out.relative = vec3f(c.x, -frame.camera.y, c.y);\n  out.position = frame.viewProj * vec4f(out.relative, 1.0);\n  return out;\n}\n\n// How much of a line a pixel at `p` (in units of the lines' spacing) is:\n// 1 on a line, 0 off it, smoothed over a pixel either way.\nfn line(p : vec2f) -> f32 {\n  let d = fwidth(p);\n  let g = abs(fract(p - 0.5) - 0.5) / max(d, vec2f(1e-5));\n  return 1.0 - min(min(g.x, g.y), 1.0);\n}\n\n// How much of an axis line a pixel is, at `x` units from it.\nfn axis(x : f32) -> f32 {\n  let d = fwidth(x);\n  return 1.0 - min(abs(x) / max(d, 1e-5) * 0.7, 1.0);\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let world = toWorld(in.relative);\n  let p = world.xz / frame.grid.x;\n  let minor = line(p);\n  let major = line(p / frame.grid.y);\n  let x = axis(world.z);\n  let z = axis(world.x);\n  var color = vec3f(0.22, 0.30, 0.38);\n  color = mix(color, vec3f(0.45, 0.60, 0.70), major);\n  // The axes: x in red, z in blue.\n  color = mix(color, vec3f(0.9, 0.3, 0.3), x);\n  color = mix(color, vec3f(0.3, 0.5, 1.0), z);\n  let coverage = max(max(minor * 0.7, major), max(x, z));\n  let fade = visible(length(in.relative));\n  return vec4f(fogged(color, in.relative), coverage * fade);\n}\n"

/-- `shaders/mipmap.wgsl`. -/
def mipmap : String :=
  "// A texture's next mip level from the one before it (`Reef/Ripples.lean`):\n// each texel the mean of the four it covers, by one linear sample at\n// their meeting point. WebGPU makes no mip levels itself.\n\n@group(0) @binding(0) var source  : texture_2d<f32>;\n@group(0) @binding(1) var between : sampler;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n// One triangle over the whole target; the fragment's position says where.\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let size = vec2f(textureDimensions(source)) * 0.5;\n  return textureSampleLevel(source, between, in.position.xy / size, 0.0);\n}\n"

/-- `shaders/ocean.wgsl`. -/
def ocean : String :=
  "// The sea's surface, one tile of it, for a moment (`Reef/Caustics.lean`):\n// Tessendorf's, a spectrum of waves summed by a fast Fourier transform.\n// The spectrum (Phillips's) says how high each wave is for its length\n// and its direction against the wind's, with a random phase and\n// amplitude of its own; each wave moves at the speed deep water gives\n// its length, its frequency rounded to a multiple of the loop's, so the\n// surface repeats in time as it does in space. The transform sums them\n// into the height at each point of a grid over the tile, and likewise\n// the slope along x and along z (each wave's slope its height times its\n// wave number): three fields, three transforms, into `field`.\n//\n// Three kernels: `spectrum` fills `spec` with one field's waves at the\n// moment; `rows` transforms each row of it into `tmp`; `columns` each\n// column of that into the field's component of `field`. A transform is\n// one workgroup to a row, each thread one element, the row in workgroup\n// memory, the butterflies in place a stage at a time.\n\nconst N = 256u;\nconst tau = 6.283185307;\nconst gravity = 9.81;\n\nstruct Sea {\n  // The tile's width, in metres; the moment, in seconds; the loop's\n  // length, in seconds; which field: 0 the height, 1 the slope along x,\n  // 2 along z.\n  tile      : f32,\n  time      : f32,\n  period    : f32,\n  component : u32,\n  // The wind's speed, in metres a second, and direction; how high the\n  // waves are, a factor; the shortest wave kept, in metres.\n  wind      : f32,\n  windX     : f32,\n  windZ     : f32,\n  amplitude : f32,\n  shortest  : f32,\n  pad0      : f32,\n  pad1      : f32,\n  pad2      : f32,\n}\n\n@group(0) @binding(0) var<uniform> sea : Sea;\n@group(0) @binding(1) var<storage, read_write> spec : array<vec2f>;\n@group(0) @binding(2) var<storage, read_write> tmp : array<vec2f>;\n@group(0) @binding(3) var<storage, read_write> field : array<vec4f>;\n\n// A number in [0, 1) from `seed`, the `n`th of its sequence.\nfn rand(seed : u32, n : u32) -> f32 {\n  var h = seed * 0x9e3779b9u + n * 0x85ebca6bu;\n  h = h ^ (h >> 16u);\n  h = h * 0x7feb352du;\n  h = h ^ (h >> 15u);\n  h = h * 0x846ca68bu;\n  h = h ^ (h >> 16u);\n  return f32(h & 0xffffffu) / 16777216.0;\n}\n\n// Two numbers from a Gaussian, mean 0, spread 1, for the cell `c`.\nfn gaussian(c : vec2u) -> vec2f {\n  let seed = (c.x * 0x8da6b343u) ^ (c.y * 0xd8163841u);\n  let u1 = max(rand(seed, 0u), 1e-6);\n  let u2 = rand(seed, 1u);\n  let r = sqrt(-2.0 * log(u1));\n  return r * vec2f(cos(tau * u2), sin(tau * u2));\n}\n\n// The wave vector of cell `c`: the grid's cells run from -N/2 to N/2 - 1\n// in each direction, in cycles across the tile.\nfn waveVector(c : vec2u) -> vec2f {\n  return (vec2f(c) - f32(N) / 2.0) * tau / sea.tile;\n}\n\n// How high the waves of wave vector `k` are, squared, by Phillips's\n// spectrum: most in the wind's direction, at lengths about the wind\n// makes, none the shortest.\nfn phillips(k : vec2f) -> f32 {\n  let kLen = length(k);\n  if (kLen < 1e-4) { return 0.0; }\n  let L = sea.wind * sea.wind / gravity;\n  let wind = normalize(vec2f(sea.windX, sea.windZ));\n  let along = dot(k / kLen, wind);\n  let kL = kLen * L;\n  let shortest = sea.shortest;\n  return sea.amplitude * exp(-1.0 / (kL * kL)) / (kLen * kLen * kLen * kLen)\n    * along * along * exp(-kLen * kLen * shortest * shortest);\n}\n\n// The wave of cell `c` at time 0: its amplitude and phase, complex.\nfn wave0(c : vec2u) -> vec2f {\n  return gaussian(c) * sqrt(phillips(waveVector(c)) * 0.5);\n}\n\n// Complex multiplication.\nfn cmul(a : vec2f, b : vec2f) -> vec2f {\n  return vec2f(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);\n}\n\n@compute @workgroup_size(16, 16)\nfn spectrum(@builtin(global_invocation_id) id : vec3u) {\n  let c = id.xy;\n  let k = waveVector(c);\n  // The wave at time t: its own turning one way, and its mirror's\n  // conjugate the other, so that the sum is real.\n  let mirror = vec2u((N - c.x) % N, (N - c.y) % N);\n  let omega0 = tau / sea.period;\n  let omega = max(1.0, round(sqrt(gravity * length(k)) / omega0)) * omega0;\n  let phase = omega * sea.time;\n  let turn = vec2f(cos(phase), sin(phase));\n  let back = vec2f(turn.x, -turn.y);\n  let m = wave0(mirror);\n  var h = cmul(wave0(c), turn) + cmul(vec2f(m.x, -m.y), back);\n  // The slopes: the height times i k.\n  if (sea.component == 1u) { h = vec2f(-h.y, h.x) * k.x; }\n  if (sea.component == 2u) { h = vec2f(-h.y, h.x) * k.y; }\n  spec[c.y * N + c.x] = h;\n}\n\nvar<workgroup> a : array<vec2f, N>;\nvar<workgroup> b : array<vec2f, N>;\n\n// `n`'s bits reversed, the low `bits` of them.\nfn reversed(n : u32, bits : u32) -> u32 {\n  var r = 0u;\n  var v = n;\n  for (var i = 0u; i < bits; i++) {\n    r = (r << 1u) | (v & 1u);\n    v = v >> 1u;\n  }\n  return r;\n}\n\n// The inverse transform of the row in `a` (loaded in bit-reversed\n// order), in place through `b`, by thread `i` of its workgroup: the\n// result is in `a` if the stages are even, else `b`.\nfn transform(i : u32) -> vec2f {\n  var fromA = true;\n  for (var s = 1u; s < N; s = s << 1u) {\n    let j = i & (s - 1u);\n    let angle = tau * f32(j) / f32(2u * s);\n    let w = vec2f(cos(angle), sin(angle));\n    let upper = (i & s) == 0u;\n    var result : vec2f;\n    if (fromA) {\n      if (upper) { result = a[i] + cmul(w, a[i + s]); }\n      else { result = a[i - s] - cmul(w, a[i]); }\n    } else {\n      if (upper) { result = b[i] + cmul(w, b[i + s]); }\n      else { result = b[i - s] - cmul(w, b[i]); }\n    }\n    workgroupBarrier();\n    if (fromA) { b[i] = result; } else { a[i] = result; }\n    workgroupBarrier();\n    fromA = !fromA;\n  }\n  if (fromA) { return a[i]; }\n  return b[i];\n}\n\n@compute @workgroup_size(N)\nfn rows(@builtin(workgroup_id) group : vec3u,\n        @builtin(local_invocation_id) local : vec3u) {\n  let row = group.x;\n  let i = local.x;\n  a[reversed(i, 8u)] = spec[row * N + i];\n  workgroupBarrier();\n  tmp[row * N + i] = transform(i);\n}\n\n@compute @workgroup_size(N)\nfn columns(@builtin(workgroup_id) group : vec3u,\n           @builtin(local_invocation_id) local : vec3u) {\n  let column = group.x;\n  let i = local.x;\n  a[reversed(i, 8u)] = tmp[i * N + column];\n  workgroupBarrier();\n  let value = transform(i).x;\n  // The grid's cells were centred: the sum is of the cell's position\n  // shifted by half the grid, a sign a cell.\n  let sign = select(1.0, -1.0, ((column + i) & 1u) == 1u);\n  let index = i * N + column;\n  var f = field[index];\n  if (sea.component == 0u) { f.x = value * sign; }\n  if (sea.component == 1u) { f.y = value * sign; }\n  if (sea.component == 2u) { f.z = value * sign; }\n  field[index] = f;\n}\n"

/-- `shaders/overlay.wgsl`. -/
def overlay : String :=
  "// The overlay: text, as pixels in a texture (white, its alpha the text's),\n// drawn a pixel to a pixel at a place in the target, on a translucent panel\n// a little larger, blended over what is there.\n\n// As `Reef.placementBytes` encodes it: 32 bytes, all in pixels, from the\n// target's top left.\nstruct Placement {\n  extent  : vec2f,  // the target's size\n  origin  : vec2f,  // the text's top left\n  size    : vec2f,  // the text's size\n  padding : f32,    // the panel's, around the text\n  pad     : f32,\n}\n\n@group(0) @binding(0) var<uniform> placement : Placement;\n@group(0) @binding(1) var text : texture_2d<f32>;\n\n@vertex fn vs(@builtin(vertex_index) v : u32) -> @builtin(position) vec4f {\n  // Two triangles: the panel's corners, 0..1 across and down.\n  var corners = array<vec2f, 6>(\n    vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0),\n    vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n  let pad = vec2f(placement.padding);\n  let p = placement.origin - pad + corners[v] * (placement.size + 2.0 * pad);\n  // Pixels, down from the top, to clip space, up from the bottom.\n  let clip = p / placement.extent * 2.0 - 1.0;\n  return vec4f(clip.x, -clip.y, 0.0, 1.0);\n}\n\n@fragment fn fs(@builtin(position) position : vec4f) -> @location(0) vec4f {\n  // The pixel's place in the text: its centre is at + 0.5.\n  let p = floor(position.xy - placement.origin);\n  var coverage = 0.0;\n  if (all(p >= vec2f(0.0)) && all(p < placement.size)) {\n    coverage = textureLoad(text, vec2i(p), 0).a;\n  }\n  let panel = vec4f(0.01, 0.04, 0.07, 0.55);\n  let ink = vec4f(0.7, 0.95, 1.0, 1.0);\n  return mix(panel, ink, coverage);\n}\n"

/-- `shaders/resolve.wgsl`. -/
def resolve : String :=
  "// The frame, drawn in light (floats, as bright as the sun's disc), made\n// colour for the display (`Reef/Render.lean`): a filmic curve (Narkowicz's\n// fit of the ACES one) that rolls the brightest light off toward white\n// rather than clipping it, at an exposure; the display's own encoding\n// (sRGB) is the target's.\n\n@group(1) @binding(0) var scene : texture_2d<f32>;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\nfn filmic(x : vec3f) -> vec3f {\n  let a = 2.51; let b = 0.03; let c = 2.43; let d = 0.59; let e = 0.14;\n  return clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3f(0.0), vec3f(1.0));\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let light = textureLoad(scene, vec2i(in.position.xy), 0).rgb;\n  return vec4f(filmic(light * frame.shaft.w), 1.0);\n}\n"

/-- `shaders/ripples.wgsl`. -/
def ripples : String :=
  "// The ripples' tile, baked once at the start (`Reef/Ripples.lean`): the\n// sand's wave ripples, in their own frame (the waves run along x, so the\n// crests run along y), as a texture that repeats. Each texel: the height,\n// 0 the lowest to 1 the highest; the slopes along x and y, in heights per\n// wavelength, as (slope / 8 + 0.5); and the cavity, how much of the sky a\n// point in a trough sees, 1 all of it. `shaders/sand.wgsl` reads them.\n//\n// The ripples are phasor noise (Tricard et al., \"Procedural Phasor\n// Noise\", 2019): a sum of kernels, bumps, each carrying a plane wave,\n// whose phase, where they interfere, is a field that oscillates at about\n// the ripples' frequency everywhere. Each kernel's wave is the ripples'\n// direction and frequency as a smooth field has them at the kernel: so\n// neighbours agree, the crests bend as the field does, and where it\n// bends enough that a crest must end or fork, one does, as ripples'\n// crests do. A profile of the phase is the height: a long gentle rise to\n// a sharp crest, a short steep fall down its lee, a round trough. On\n// that, small ripples, the same field at a few times the frequency, and\n// scour pits, hollows scattered sparsely and sunk where the troughs are.\n// The field is periodic over the tile, and each wave has a whole number\n// of cycles across it, so the tile repeats.\n//\n// Three passes: `fs_height` writes the height alone (a kernel sum a\n// texel); `fs_finish` reads it back for the slopes and the cavity, and\n// `fs_horizons` for the horizons, which need the height at many points\n// each.\n\nstruct Bake {\n  // Ripples across the tile; how far the ripples' direction strays from\n  // the waves', in radians; how far out of step the kernels are, 0 none\n  // to 1 wholly; the crests' sharpness, a power.\n  shape : vec4f,\n  // The ripples' steepness, trough to crest over the wavelength, for the\n  // cavity; the tile's texels a side; how much of the wavelength the\n  // gentle rise takes, 0.5 symmetric; the small ripples' height, as a\n  // fraction of the ripples'.\n  size  : vec4f,\n  // The pits: how many a wavelength's square (0 to 1); their depth, as a\n  // fraction of the ripples' height. The slip faces: the slope of sand\n  // at rest (the tangent of its angle of repose); how much of the field\n  // has them, 0 none to 1 all.\n  pits  : vec4f,\n}\n\n@group(0) @binding(0) var<uniform> bake : Bake;\n@group(0) @binding(1) var heights : texture_2d<f32>;\n\nconst tau = 6.283185307;\nconst kernelsPerCell = 8u;\n// The direction's and the frequency's fields: this many features across\n// the tile.\nconst bends = 4.0;\n// The small ripples: this many to one of the ripples.\nconst fineRipples = 4.0;\n// A pit's half-width across the trough and along it, in wavelengths, at\n// its largest: under 1, so that the cells around a point hold every pit\n// reaching it.\nconst pitAcross = 0.4;\nconst pitAlong = 0.8;\n// The pits come in runs, where the water scours: this many across the\n// tile.\nconst pitRuns = 6.0;\n// The small ripples come in patches: this many across the tile.\nconst patches = 8.0;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n// One triangle over the whole target; the fragment's position says where.\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\n// A number in [0, 1) from `seed`, the `n`th of its sequence.\nfn rand(seed : u32, n : u32) -> f32 {\n  var h = seed + n * 0x9e3779b9u;\n  h = h ^ (h >> 16u);\n  h = h * 0x7feb352du;\n  h = h ^ (h >> 15u);\n  h = h * 0x846ca68bu;\n  h = h ^ (h >> 16u);\n  return f32(h & 0xffffffu) / 16777216.0;\n}\n\n// The seed of the cell `cell` of a grid `n` wide over the tile, the grid\n// repeating with it, salted by `salt`.\nfn cellSeed(cell : vec2i, n : i32, salt : u32) -> u32 {\n  let wrapped = ((cell % n) + n) % n;\n  return (u32(wrapped.x) * 0x8da6b343u) ^ (u32(wrapped.y) * 0xd8163841u) ^ salt;\n}\n\n// A gradient at the lattice point `p` of a lattice `period` wide, which\n// repeats: a direction, not unit.\nfn gradient(p : vec2i, period : i32) -> vec2f {\n  var h = cellSeed(p, period, 0u);\n  h = h ^ (h >> 15u);\n  h = h * 0x2c1b3c6du;\n  h = h ^ (h >> 12u);\n  let a = f32(h & 0xffffu) / 65535.0;\n  let b = f32((h >> 16u) & 0xffffu) / 65535.0;\n  return vec2f(a, b) * 2.0 - 1.0;\n}\n\n// Gradient noise at `p`, repeating every `period`: smooth, about -1 to 1,\n// a feature a unit wide.\nfn noise(p : vec2f, period : i32) -> f32 {\n  let i = vec2i(floor(p));\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  let a = dot(gradient(i, period), f);\n  let b = dot(gradient(i + vec2i(1, 0), period), f - vec2f(1.0, 0.0));\n  let c = dot(gradient(i + vec2i(0, 1), period), f - vec2f(0.0, 1.0));\n  let d = dot(gradient(i + vec2i(1, 1), period), f - vec2f(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 1.4;\n}\n\n// The ripples' wave at `p`, in tile units, for ripples `scale` times as\n// fine as the ripples: their direction, which strays from the waves' by\n// up to the spread (the small ripples straying further, on their own\n// account), and their frequency, which strays by a tenth, each as a\n// smooth field over the tile; in cycles across the tile, whole, so that\n// the tile repeats.\nfn waveAt(p : vec2f, scale : f32) -> vec2f {\n  var angle = bake.shape.y * noise(p * bends, i32(bends));\n  if (scale > 1.0) {\n    angle += 0.35 * noise(p * bends * 2.0 + 5.0, i32(bends * 2.0));\n  }\n  let frequency = bake.shape.x * (1.0 + 0.1 * noise(p * bends + 17.0, i32(bends)));\n  return round(scale * frequency * vec2f(cos(angle), sin(angle)));\n}\n\n// The kernels' sum at `p`, in tile units (0 to 1 across the tile, and\n// on, the tile repeating), and their weights' sum, for ripples `scale`\n// times as fine as the ripples (1 the ripples themselves): the phase is\n// the sum's argument; its length against the weights' says how far the\n// kernels agree there. The kernels sit in cells two wavelengths wide, a\n// few to a cell, each a bump a cell wide, those of the cells around `p`\n// summed; a cell's kernels are those of its cell in the tile, so that\n// the tile repeats.\nfn phasor(p : vec2f, scale : f32) -> vec3f {\n  let disorder = bake.shape.z;\n  let cells = bake.shape.x * scale / 2.0;\n  let n = i32(cells);\n  let base = vec2i(floor(p * cells));\n  var sum = vec2f(0.0);\n  var weights = 0.0;\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let cell = base + vec2i(i, j);\n      for (var k = 0u; k < kernelsPerCell; k++) {\n        let seed = cellSeed(cell, n, k * 0xcb1ab31fu + u32(scale) * 0x3d4d51cbu);\n        let centre = (vec2f(cell) + vec2f(rand(seed, 0u), rand(seed, 1u))) / cells;\n        let wave = waveAt(centre, scale);\n        // A bump a cell wide, and nothing beyond: the cells around are\n        // all that is summed, and a kernel reaching past them would be\n        // cut off at their edge, a line through the tile.\n        let d = (p - centre) * cells;\n        let r2 = dot(d, d);\n        let weight = select(0.0, (1.0 - r2) * (1.0 - r2), r2 < 1.0);\n        // The wave's phase from the tile's origin, not the kernel's: so\n        // kernels of one wave agree, and only those of different waves,\n        // or put out of step, interfere.\n        let phi = tau * (dot(wave, p) + disorder * rand(seed, 2u));\n        sum += weight * vec2f(cos(phi), sin(phi));\n        weights += weight;\n      }\n    }\n  }\n  return vec3f(sum, weights);\n}\n\n// How far the crests are rounded: a little, so that the normal has no\n// one-texel cusp to show as a line along every crest.\nconst rounding = 0.02;\n\n// The height for a phase, were the ripples symmetric: 1 at a crest\n// (phase 0), 0 in a trough; the crests sharp (though rounded a little)\n// and the troughs round, more so the lower the power.\nfn symmetric(phi : f32) -> f32 {\n  let p = bake.shape.w;\n  let lo = pow(rounding, p);\n  let hi = pow(1.0 + rounding, p);\n  return 1.0 - (pow((1.0 - cos(phi)) * 0.5 + rounding, p) - lo) / (hi - lo);\n}\n\n// The lee of a ripple with a slip face, `t` of the wavelength from the\n// crest, the fall taking `fall` of it: sand carried over the brink comes\n// to rest at its angle of repose, a straight face from the brink down,\n// then runs out in a concave toe to the trough (a cubic, meeting the\n// face's slope and the trough's flat).\nfn slipFace(t : f32, fall : f32) -> f32 {\n  // The face's slope, in heights a wavelength: the sand's over the\n  // ripples' steepness; three quarters of the way down on it.\n  let slope = bake.pits.z / bake.size.x;\n  let toeAt = min(0.75 / slope, fall * 0.6);\n  let toeHeight = 1.0 - slope * toeAt;\n  if (t < toeAt) { return 1.0 - slope * t; }\n  let u = (t - toeAt) / (fall - toeAt);\n  let u2 = u * u;\n  let u3 = u2 * u;\n  // Hermite: from toeHeight, sloping as the face, to 0, flat.\n  let startSlope = -slope * (fall - toeAt);\n  return max(toeHeight * (2.0 * u3 - 3.0 * u2 + 1.0) + startSlope * (u3 - 2.0 * u2 + u), 0.0);\n}\n\n// The height for a phase: the symmetric profile's, with the cycle\n// warped so that the fall from the crest down its lee (the phase runs\n// along the waves) takes the short part of the wavelength and the rise\n// up the next the long part. The trough, where the symmetric profile is\n// flat, stays smooth across the warp's kink; the crest is a kink anyway.\n// The lee is a slip face by `slip`, 0 the rounded fall to 1 the face.\nfn profile(phi : f32, slip : f32) -> f32 {\n  let rise = bake.size.z;\n  let fall = 1.0 - rise;\n  let t = fract(phi / tau);\n  let warped = select(0.5 + 0.5 * (t - fall) / rise, 0.5 * t / fall, t < fall);\n  let rounded = symmetric(tau * warped);\n  if (t >= fall || slip <= 0.0) { return rounded; }\n  return mix(rounded, slipFace(t, fall), slip);\n}\n\n// The ripples' height from the kernels' sum `s`: the profile of the\n// phase, tapering where the kernels disagree (the sum short against the\n// weights), as a crest tapers out where it ends or forks; the phase\n// alone would jump there, a cliff. Not to nothing: a quarter of the\n// height stays, faint ripples rather than a flat, and where the phase\n// does jump, a step a quarter the size.\nfn rippleOf(s : vec3f, slip : f32) -> f32 {\n  let agreement = length(s.xy) / s.z;\n  let taper = mix(0.25, 1.0, smoothstep(0.02, 0.15, agreement));\n  return mix(0.5, profile(atan2(s.y, s.x), slip), taper);\n}\n\n// How far the ripples at `p` have slip faces, 0 none to 1 wholly: in\n// stretches, where the ripples are active, a field of noise says; this\n// many across the tile.\nconst slipStretches = 5.0;\nfn slipAt(p : vec2f) -> f32 {\n  let field = noise(p * slipStretches + 23.0, i32(slipStretches));\n  return bake.pits.w * smoothstep(-0.3, 0.3, field + (bake.pits.w - 0.5) * 0.6);\n}\n\n// How much of a pit `p` is in, 0 none to 1 the bottom of one: pits are\n// scattered one to some of the wavelength's squares, in runs (a field\n// of noise says where they are many and where none), each a hollow\n// longer along the troughs than across them, of a size, depth and turn\n// of its own, steep on its upwave side (behind whatever the water\n// scoured it round) and tailing off down it, its rim soft.\nfn pitsAt(p : vec2f) -> f32 {\n  let n = i32(bake.shape.x);\n  let base = vec2i(floor(p * f32(n)));\n  let runs = smoothstep(-0.1, 0.5, noise(p * pitRuns + 47.0, i32(pitRuns)));\n  var pit = 0.0;\n  for (var j = -1; j <= 1; j++) {\n    for (var i = -1; i <= 1; i++) {\n      let cell = base + vec2i(i, j);\n      let seed = cellSeed(cell, n, 0x5bd1e995u);\n      let centre = (vec2f(cell) + vec2f(rand(seed, 1u), rand(seed, 2u))) / f32(n);\n      let there = smoothstep(-0.1, 0.5, noise(centre * pitRuns + 47.0, i32(pitRuns)));\n      if (rand(seed, 0u) >= bake.pits.x * there) { continue; }\n      let size = 0.5 + 0.5 * rand(seed, 3u);\n      let depth = 0.5 + 0.5 * rand(seed, 4u);\n      let turn = 0.3 * (rand(seed, 5u) - 0.5);\n      let along = vec2f(-sin(turn), cos(turn));\n      let d = (p - centre) * f32(n);\n      var e = vec2f(dot(d, vec2f(along.y, -along.x)), dot(d, along));\n      // Across the trough (x, up the waves), the upwave half squeezed\n      // and the downwave half drawn out.\n      e.x = e.x / select(1.4, 0.6, e.x < 0.0);\n      e = e / (vec2f(pitAcross, pitAlong) * size);\n      let q = dot(e, e);\n      pit += select(0.0, depth * smoothstep(1.0, 0.0, q), q < 1.0);\n    }\n  }\n  return min(pit, 1.0) * max(runs, 0.0);\n}\n\n// The height at `p`: the ripples', the small ripples' on them, in\n// patches, and the pits sunk into them where they are low (a pit on a\n// crest is no pit), the three summed and scaled back to 0 to 1\n// (`Reef.Ripples.height` is the sum's scale).\nfn heightOf(p : vec2f) -> f32 {\n  let fine = bake.size.w;\n  let depth = bake.pits.y;\n  let ripples = rippleOf(phasor(p, 1.0), slipAt(p));\n  let patchy = smoothstep(-0.2, 0.5, noise(p * patches + 31.0, i32(patches)));\n  let small = mix(0.5, rippleOf(phasor(p, fineRipples), 0.0), patchy);\n  let pit = pitsAt(p) * (1.0 - ripples);\n  return (ripples + fine * small + depth * (1.0 - pit)) / (1.0 + fine + depth);\n}\n\n@fragment fn fs_height(in : Out) -> @location(0) vec4f {\n  let uv = in.position.xy / bake.size.y;\n  return vec4f(heightOf(uv), 0.0, 0.0, 1.0);\n}\n\n// The height baked at texel `t`, the tile repeating.\nfn heightAt(t : vec2i) -> f32 {\n  let n = i32(bake.size.y);\n  return textureLoad(heights, ((t % n) + n) % n, 0).r;\n}\n\n@fragment fn fs_finish(in : Out) -> @location(0) vec4f {\n  let t = vec2i(in.position.xy);\n  let h = heightAt(t);\n  // A texel, in wavelengths.\n  let texel = bake.shape.x / bake.size.y;\n  let sx = (heightAt(t + vec2i(1, 0)) - heightAt(t - vec2i(1, 0))) / (2.0 * texel);\n  let sy = (heightAt(t + vec2i(0, 1)) - heightAt(t - vec2i(0, 1))) / (2.0 * texel);\n  // The cavity: the horizon either way along x (across the crests), as\n  // the highest rise over run out to a wavelength, at the height's\n  // steepness (the ripples' and what is on them); what is left of the\n  // sky between the two.\n  let steepness = bake.size.x * (1.0 + bake.size.w + bake.pits.y);\n  let steps = 16;\n  let stride = max(1, i32(1.0 / texel) / steps);\n  var tanP = 0.0;\n  var tanM = 0.0;\n  for (var i = 1; i <= steps; i++) {\n    let run = f32(i * stride) * texel;\n    tanP = max(tanP, (heightAt(t + vec2i(i * stride, 0)) - h) * steepness / run);\n    tanM = max(tanM, (heightAt(t - vec2i(i * stride, 0)) - h) * steepness / run);\n  }\n  let cavity = 1.0 - 0.5 * (tanP / sqrt(1.0 + tanP * tanP)\n                            + tanM / sqrt(1.0 + tanM * tanM));\n  return vec4f(h, sx / 8.0 + 0.5, sy / 8.0 + 0.5, cavity);\n}\n\n// The horizon from texel `t` along `step` (a direction, in texels): the\n// highest rise over run out to a wavelength, as an angle up from the\n// flat, 0 to 1 of a right angle.\nfn horizonAlong(t : vec2i, h : f32, step : vec2i) -> f32 {\n  let texel = bake.shape.x / bake.size.y;\n  let steepness = bake.size.x * (1.0 + bake.size.w + bake.pits.y);\n  let steps = 16;\n  let stride = max(1, i32(1.0 / texel) / steps);\n  var rise = 0.0;\n  for (var i = 1; i <= steps; i++) {\n    let run = f32(i * stride) * texel;\n    rise = max(rise, (heightAt(t + step * i * stride) - h) * steepness / run);\n  }\n  return atan(rise) / 1.5707963;\n}\n\n// The horizons: along the waves (x) and back, across them (y) and back;\n// the sun is below one where its elevation is less, in the shade.\n@fragment fn fs_horizons(in : Out) -> @location(0) vec4f {\n  let t = vec2i(in.position.xy);\n  let h = heightAt(t);\n  return vec4f(horizonAlong(t, h, vec2i(1, 0)), horizonAlong(t, h, vec2i(-1, 0)),\n               horizonAlong(t, h, vec2i(0, 1)), horizonAlong(t, h, vec2i(0, -1)));\n}\n"

/-- `shaders/sand.wgsl`. -/
def sand : String :=
  "// The sand: the floor, a quadtree of patches (`Reef/Floor.lean`), each\n// the one lattice placed and scaled by its node's record, lifted to the\n// floor's height (`height`, in shaders/frame.wgsl) and, near the camera,\n// its ripples' (`rippleHeight`); lit by a sun from above with the normal\n// found at each pixel, from the floor's slope, the ripples' and the\n// grains', the troughs shaded, the colour speckled by the grains, the\n// sun's light focused by the surface's waves into caustics; seen through\n// the water, which takes its colours with distance and scatters in its\n// own.\n\n// The nodes drawn this frame: each its corner nearest the origin (x, z)\n// and its size, in whole leaf cells, the corner's from the cell the eye\n// is in; and its level, 0 the leaves. Whole numbers, so that a vertex two\n// nodes share comes out the same in both, to the last bit.\n@group(0) @binding(1) var<storage, read> nodes : array<vec4f>;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n  @location(0)       relative : vec3f,  // to the camera\n  @location(7)       bary     : vec3f,  // the wireframe's (shaders/wire.wgsl)\n}\n\n// Where `xz`, in the world, is on the ripples' tile: along the waves, and\n// across them, in tiles (`shaders/ripples.wgsl`).\nfn rippleUV(xz : vec2f) -> vec2f {\n  let dir = frame.ripple.xy;\n  return vec2f(dot(xz, dir), dot(xz, vec2f(-dir.y, dir.x))) / frame.tiling.x;\n}\n\n// What the ripples add to the floor's height at `xz`, in the world, for\n// a vertex `dist` from the eye: a crest half their height up, a trough\n// half down, from the tile's mip level smoothed over twice the mesh's\n// cell at that distance (the leaves' within their range, doubling with\n// it), so that the vertices carry what they can and not a sample each\n// of what they cannot, which would be ragged; what is finer than the\n// mesh the normal map keeps.\nfn rippleHeight(xz : vec2f, dist : f32) -> f32 {\n  let texel = frame.tiling.x / f32(textureDimensions(ripples, 0).x);\n  let cell = frame.eye.z * max(1.0, 2.0 * dist / frame.floor.y);\n  let lod = log2(max(1.0, 2.0 * cell / texel));\n  let h = textureSampleLevel(ripples, rippleSampler, rippleUV(xz), lod).r;\n  return (h - 0.5) * frame.ripple.w;\n}\n\n// How much the ripples lift the mesh `dist` from the eye: wholly near it,\n// where the patches are fine enough to carry them; beyond, the normal map\n// carries them alone.\nfn rippleFade(dist : f32) -> f32 {\n  return 1.0 - smoothstep(frame.tiling.y, frame.tiling.z, dist);\n}\n\n// The floor's point at `cellXZ`, in leaf cells from the eye's cell,\n// relative to the camera, as `height` says, and the ripples near the eye.\nfn floorAt(cellXZ : vec2f) -> vec3f {\n  let xz = cellXZ * frame.eye.z - frame.eye.xy;\n  let world = xz + frame.camera.xz;\n  let dist = length(xz);\n  let y = height(world) + rippleHeight(world, dist) * rippleFade(dist);\n  return vec3f(xz.x, y - frame.camera.y, xz.y);\n}\n\n// How far a vertex `dist` from the eye is morphed at level `level`: 0\n// before the level's range's `morph` fraction, 1 a little short of the\n// range (so that a vertex at it is wholly morphed whatever the floats say).\nfn morph(dist : f32, level : f32) -> f32 {\n  let range = frame.floor.y * exp2(level);\n  let start = range * frame.floor.z;\n  let end = range - (range - start) * 0.05;\n  return clamp((dist - start) / (end - start), 0.0, 1.0);\n}\n\n// A lattice vertex of the node `instance` (its record relative to the\n// camera): placed in the node, and, near the node's range, morphed onto\n// its parent's lattice (every other vertex moved onto the one before it),\n// so that the node meets a neighbour at the level above with no crack,\n// and leaves for the level above with no pop. The morph begins at the\n// range's `morph` fraction of the way out, by the vertex's own distance\n// from the eye. The three levels above are morphed too, as a neighbour\n// at those levels would morph the same vertex, so that the two agree\n// wherever they meet, whatever the distances (three, for relief many\n// times the design's, which carries a node's vertices far).\n@vertex fn vs(@location(0) lattice : vec2f,\n              @builtin(vertex_index) index : u32,\n              @builtin(instance_index) instance : u32) -> Out {\n  let node = nodes[instance];\n  let cells = frame.floor.x;\n  // Leaf cells a lattice step: a power of two, exact.\n  let step = node.z / cells;\n  var morphed = lattice;\n  for (var k = 0u; k < 4u; k++) {\n    // The distance from where the vertex is after the levels below: a\n    // vertex moved onto another must go on as that one does.\n    let dist = length(floorAt(node.xy + morphed * step));\n    let s = exp2(f32(k + 1u));\n    morphed = morphed - fract(morphed / s) * s * morph(dist, node.w + f32(k));\n  }\n  var out : Out;\n  out.relative = floorAt(node.xy + morphed * step);\n  out.position = frame.viewProj * vec4f(out.relative, 1.0);\n  out.bary = barycentric(index);\n  return out;\n}\n\n// The grains' tile is small, and would show its repeating a few tile\n// widths off; so it is read through a grid of triangles, each corner of\n// which reads the tile from a place of its own, and the three readings\n// blended by how near the corners are (Heitz and Neyret, \"High-\n// Performance By-Example Noise using a Histogram-Preserving Blending\n// Operator\", 2018): no two triangles show the same part of the tile,\n// and no seam between them. The triangles are smaller than the tile, so\n// that it never repeats even within one (a grid of a few tiles across\n// let it, and the repeat showed at a metre). A blend of three is flatter\n// than any one, so what varies is scaled back up by the weights' length:\n// the tilt, which varies about zero, and the brightness, which varies\n// about a half.\nconst grainTriangles = 0.4;  // tile widths across one\n\n// Where `uv`, in tile widths, falls in the grid of triangles: the\n// three corners, and how near each (the barycentric weights).\nfn triangleAt(uv : vec2f) -> mat3x3f {\n  let skewed = mat2x2f(1.0, 0.0, -0.57735027, 1.15470054) * (uv / grainTriangles);\n  let base = floor(skewed);\n  let f = fract(skewed);\n  if (f.x + f.y < 1.0) {\n    return mat3x3f(vec3f(base, 1.0 - f.x - f.y),\n                   vec3f(base + vec2f(1.0, 0.0), f.x),\n                   vec3f(base + vec2f(0.0, 1.0), f.y));\n  }\n  return mat3x3f(vec3f(base + vec2f(1.0, 1.0), f.x + f.y - 1.0),\n                 vec3f(base + vec2f(1.0, 0.0), 1.0 - f.y),\n                 vec3f(base + vec2f(0.0, 1.0), 1.0 - f.x));\n}\n\n// The place a corner `corner` of the grid reads the tile from: an\n// offset of its own, in tile widths.\nfn cornerOffset(corner : vec2f) -> vec2f {\n  let c = vec2i(corner);\n  var h = (u32(c.x) * 0x8da6b343u) ^ (u32(c.y) * 0xd8163841u) ^ 0x3u;\n  h = h ^ (h >> 15u);\n  h = h * 0x2c1b3c6du;\n  h = h ^ (h >> 12u);\n  return vec2f(f32(h & 0xffffu), f32((h >> 16u) & 0xffffu)) / 65535.0;\n}\n\n// The grains' tile at `xz`, in the world, read through the grid of\n// triangles, for a pixel whose footprint is `along` and `across`, the\n// grains `coarser` times their size (the sand sorted: coarser in the\n// ripples' troughs, finer on their crests): the normal, not unit\n// (shorter where the filtering has averaged it), and the brightness. The\n// tilt and the brightness are scaled back up to the tile's contrast; the\n// normal's height is the plain blend, as its length is what is wanted\n// of it.\nfn grainsAt(xz : vec2f, along : vec2f, across : vec2f, coarser : f32,\n            still : f32) -> vec4f {\n  let uv = xz / frame.grain.x;\n  let corners = triangleAt(uv);\n  var sum = vec4f(0.0);\n  var weights = 0.0;\n  for (var i = 0; i < 3; i++) {\n    let corner = corners[i];\n    // Scaled about the corner, not the world's origin: the scale varies\n    // over the ripples, and about the origin that would smear the tile.\n    let cornerUV = mat2x2f(1.0, 0.0, 0.5, 0.8660254) * corner.xy * grainTriangles;\n    let local = (uv - cornerUV) / coarser + cornerUV;\n    // The layer with the traces where the sand is still, the one without\n    // where it moves: both, blended, where it is between.\n    let at = local + cornerOffset(corner.xy);\n    let dx = along / (frame.grain.x * coarser);\n    let dy = across / (frame.grain.x * coarser);\n    let read = mix(textureSampleGrad(grains, rippleSampler, at, 1, dx, dy),\n                   textureSampleGrad(grains, rippleSampler, at, 0, dx, dy), still);\n    sum += corner.z * (read - 0.5);\n    weights += corner.z * corner.z;\n  }\n  let scaled = sum / sqrt(weights);\n  return vec4f(scaled.x * 2.0, sum.y * 2.0, scaled.z * 2.0, scaled.w + 0.5);\n}\n\n// Oren and Nayar's diffuse lighting of a rough surface, `sigma2` the\n// square of its roughness (the spread of its facets, in radians), with\n// normal `n`, lit from `l`, seen from `v`: like Lambert's, but a rough\n// surface shows the same from every angle when lit from behind the\n// viewer, and darkens toward the light, as sand does.\nfn roughDiffuse(n : vec3f, l : vec3f, v : vec3f, sigma2 : f32) -> f32 {\n  let nl = max(dot(n, l), 0.0);\n  let nv = max(dot(n, v), 0.0);\n  let a = 1.0 - 0.5 * sigma2 / (sigma2 + 0.33);\n  let b = 0.45 * sigma2 / (sigma2 + 0.09);\n  let s = dot(l, v) - nl * nv;\n  let t = select(1.0, max(nl, nv), s > 0.0);\n  return nl * (a + b * s / max(t, 1e-4));\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let world = toWorld(in.relative);\n  let dist = length(in.relative);\n  let view = in.relative / dist;\n  // The pixel's footprint on the floor: its width square on, and, along\n  // the view, longer as the view slants. Found from the pixel's angle and\n  // the floor's slope, not the screen's differences, which at a crest's\n  // silhouette span the gap to the ripple behind, and would fetch the\n  // tile's mean there: a flat normal, a bright line along every crest.\n  let foot = dist * frame.camera.w;\n  // The floor's slope at this pixel, by differences a footprint wide, at\n  // least a few centimetres: smooth, whatever the tessellation.\n  var slope = floorSlope(world.xz, max(foot, 0.03));\n  let floorNormal = normalize(vec3f(-slope.x, 1.0, -slope.y));\n  let slant = max(abs(dot(floorNormal, view)), 0.02);\n  let ahead = select(vec2f(1.0, 0.0), normalize(view.xz), length(view.xz) > 1e-4);\n  let footAlong = ahead * (foot / slant);\n  let footAcross = vec2f(-ahead.y, ahead.x) * foot;\n  // The ripples' slope, from their tile, filtered to that footprint (so\n  // that far off, where they are finer than a pixel, they average away):\n  // in heights per wavelength along the waves and across, made metres\n  // per metre, and turned to the world's axes.\n  let tile = textureSampleGrad(ripples, rippleSampler, rippleUV(world.xz),\n                               rippleUV(footAlong), rippleUV(footAcross));\n  let along = (tile.gb * 2.0 - 1.0) * 8.0 * frame.ripple.w / frame.ripple.z;\n  let dir = frame.ripple.xy;\n  slope += along.x * dir + along.y * vec2f(-dir.y, dir.x);\n  // The grains' tilt, from their tile over the world's axes, filtered\n  // likewise: where they are finer than the pixel, the normal averages\n  // to flat, and shorter (the roughness they leave, Toksvig's measure,\n  // for the lighting to come), so the tilt fades out of its own accord.\n  // The sand sorted by the ripples: the water carries the fine grains up\n  // the crests and leaves the coarse in the troughs, which are a little\n  // darker for it.\n  let sorted = mix(1.35, 0.8, tile.r);\n  // What lives in the sand digs where the sand is still: in the ripples'\n  // troughs, not on their crests, which the water sweeps; and in\n  // colonies, patches a few ripples across with bare sand between (a\n  // field of noise over the world, half a metre a feature).\n  let colonies = smoothstep(0.05, 0.4, noise(world.xz / 0.5 + 77.0));\n  let still = (1.0 - smoothstep(0.2, 0.55, tile.r)) * colonies;\n  let grain = grainsAt(world.xz, footAlong, footAcross, sorted, still);\n  let tilt = grain.xyz;\n  slope += frame.grain.y * vec2f(-tilt.x, -tilt.z) / max(tilt.y, 0.2);\n  let normal = normalize(vec3f(-slope.x, 1.0, -slope.y));\n  // The sand's roughness: its own, grain on grain, and what the\n  // filtering has averaged out of the grains' normal, which is shorter\n  // by that much (Toksvig).\n  let shortened = max(length(tilt), 0.2);\n  let sigma2 = 0.36 + (1.0 - shortened) / shortened;\n  let sun = frame.sun.xyz;\n  // Whether the sun is up over the ripples here: the horizon toward it,\n  // from the four the tile holds, against its elevation; softly, as the\n  // horizons, filtered, are a mean over what is under the pixel.\n  let sunAcross = vec2f(dot(sun.xz, dir), dot(sun.xz, vec2f(-dir.y, dir.x)));\n  let toward = max(vec4f(sunAcross.x, -sunAcross.x, sunAcross.y, -sunAcross.y),\n                   vec4f(0.0));\n  let rims = textureSampleGrad(horizons, rippleSampler, rippleUV(world.xz),\n                               rippleUV(footAlong), rippleUV(footAcross));\n  let horizon = dot(toward, rims) / max(dot(toward, vec4f(1.0)), 1e-4) * 1.5707963;\n  let lit = smoothstep(horizon - 0.15, horizon + 0.15, asin(clamp(sun.y, -1.0, 1.0)));\n  // The sand's colour, speckled by the grains: each its own brightness,\n  // the gaps between them dark; far off, their mean.\n  let sand = vec3f(0.66, 0.5, 0.26) * mix(1.0, 2.0 * grain.a, frame.grain.z)\n    * mix(0.88, 1.0, tile.r);\n  // Lit by the sky as much as it can see, and by the sun where it is up,\n  // through the caustics (found where the sun's ray through this point\n  // meets the surface, so that they drift down the sun's slant).\n  let cavity = mix(1.0, tile.a, frame.tiling.w);\n  let toSurface = (frame.water.x - world.y) / max(sun.y, 0.1);\n  // Where the sun's ray through this point meets the surface, and where\n  // the swell has carried the chop there from: the caustics slide with\n  // each wave.\n  var onSurface = world.xz + sun.xz * toSurface;\n  onSurface -= swellDriftAt(onSurface, frame.screen.z);\n  // The caustics' loop at this moment: the layer, and the next, blended;\n  // blurred at least by the sun's own width, half a degree of sky, over\n  // the water the light has come down through.\n  let causticTile = frame.caustic.x;\n  let moments = frame.caustic.z;\n  let moment = fract(frame.screen.z / frame.caustic.y) * moments;\n  let layer = i32(floor(moment));\n  let next = (layer + 1) % i32(moments);\n  let sunBlur = toSurface * 0.0093;\n  let blurAlong = footAlong * max(1.0, sunBlur / max(length(footAlong), 1e-5));\n  let blurAcross = footAcross * max(1.0, sunBlur / max(length(footAcross), 1e-5));\n  let uv = onSurface / causticTile;\n  let dx = blurAlong / causticTile;\n  let dy = blurAcross / causticTile;\n  let gathered = mix(textureSampleGrad(caustics, rippleSampler, uv, layer, dx, dy).rgb,\n                     textureSampleGrad(caustics, rippleSampler, uv, next, dx, dy).rgb,\n                     fract(moment)) * causticBrightest;\n  let focus = mix(vec3f(1.0), gathered, frame.water.y);\n  let light = frame.skylight.rgb * cavity\n    + frame.sunlight.rgb * roughDiffuse(normal, sun, -view, sigma2) * lit * focus;\n  let color = sand * light;\n  return vec4f(fogged(color, in.relative), 1.0);\n}\n"

/-- `shaders/shaftblend.wgsl`. -/
def shaftblend : String :=
  "// The light in the water, drawn at half the target's size\n// (`shaders/shafts.wgsl`), added over the scene at full size: each\n// pixel the mean of the twenty-five half-size pixels about it, which\n// smooths the march's grain away and softens the rays\n// (`Reef/Render.lean`).\n\n@group(1) @binding(0) var shaftLight : texture_2d<f32>;\n@group(1) @binding(1) var shaftSampler : sampler;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let size = vec2f(textureDimensions(shaftLight));\n  let uv = in.position.xy / frame.screen.xy;\n  let texel = 1.0 / size;\n  var sum = vec3f(0.0);\n  for (var j = -2; j <= 2; j++) {\n    for (var i = -2; i <= 2; i++) {\n      sum += textureSampleLevel(shaftLight, shaftSampler, uv + vec2f(f32(i), f32(j)) * texel, 0.0).rgb;\n    }\n  }\n  return vec4f(sum / 25.0, 1.0);\n}\n"

/-- `shaders/shafts.wgsl`. -/
def shafts : String :=
  "// The light in the water (`Reef/Render.lean`): the sun's light scattered\n// toward the camera by the fine matter the water holds, brighter in the\n// columns under the surface's bright filaments, so the caustics show as\n// shafts. One triangle over a target half the scene's size, after the\n// scene is drawn (added over it, smoothed, by shaders/shaftblend.wgsl),\n// each pixel marching its view ray from the camera to what it sees (the\n// depth buffer says how far), summing at each step the sun's light there,\n// through the caustics' loop where the sun's ray through the step meets\n// the surface, taken by the water on its way down and again on its way\n// to the camera, scattered forward more than back; added to the pixel.\n// The steps begin at an offset that differs pixel to pixel, so that few\n// steps leave no bands, only a fine grain the eye does not see.\n\n@group(1) @binding(0) var sceneDepth : texture_depth_2d;\n\nstruct Out {\n  @builtin(position) position : vec4f,\n}\n\n@vertex fn vs(@builtin(vertex_index) i : u32) -> Out {\n  let xy = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n  var out : Out;\n  out.position = vec4f(xy * 2.0 - 1.0, 0.0, 1.0);\n  return out;\n}\n\n// A number in [0, 1) for the pixel `p`, differing from its neighbours'\n// as evenly as can be (Jimenez's interleaved gradient noise), so that\n// the steps' offsets make a fine, even grain and not a blotchy one.\nfn dither(p : vec2u) -> f32 {\n  let f = vec2f(p);\n  return fract(52.9829189 * fract(0.06711056 * f.x + 0.00583715 * f.y));\n}\n\n// Henyey and Greenstein's phase: how much light going one way is\n// scattered to another at `cosine` between them, `g` the asymmetry,\n// forward for g > 0.\nfn phase(cosine : f32, g : f32) -> f32 {\n  let d = 1.0 + g * g - 2.0 * g * cosine;\n  return (1.0 - g * g) / (4.0 * 3.14159265 * d * sqrt(d));\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  // At half size: the scene's pixel is twice this one.\n  let pixel = vec2u(in.position.xy);\n  let scenePixel = pixel * 2u;\n  let ndc = (in.position.xy * 2.0 / frame.screen.xy) * 2.0 - 1.0;\n  let dir = normalize(frame.forward.xyz + frame.right.xyz * (ndc.x * frame.right.w)\n                      - frame.up.xyz * (ndc.y * frame.up.w));\n  // How far the pixel sees: the depth buffer's, made a distance along\n  // the ray (the projection's: near * far / (far - z * (far - near)) is\n  // the view's depth), or the water's reach where there is nothing.\n  let z = textureLoad(sceneDepth, vec2i(scenePixel), 0);\n  let near = frame.surface.z;\n  let far = frame.surface.w;\n  let viewDepth = near * far / (far - z * (far - near));\n  let along = max(dot(dir, frame.forward.xyz), 0.05);\n  let reach = frame.shaft.z;\n  let dist = min(select(viewDepth / along, reach, z >= 1.0), reach);\n  let steps = i32(frame.shaft.y);\n  let dt = dist / f32(steps);\n  let sun = frame.sun.xyz;\n  let extinct = frame.extinct.rgb;\n  // Forward-scattering, a little back: the sun's light comes down along\n  // -sun, the view looks along dir, so the angle between the light and\n  // what reaches the camera (going along -dir) has cosine dot(sun, dir).\n  let scatter = phase(dot(sun, dir), 0.6) * 0.8 + 0.2 / (4.0 * 3.14159265);\n  let moments = frame.caustic.z;\n  let moment = fract(frame.screen.z / frame.caustic.y) * moments;\n  let layer = i32(floor(moment));\n  let next = (layer + 1) % i32(moments);\n  let blend = fract(moment);\n  let causticTile = frame.caustic.x;\n  // The caustics read sharp: the shafts are columns, and a step along\n  // the ray crosses them, it does not average them (the dither does\n  // that, between pixels); only far off, where a pixel spans cells, the\n  // level the pixel's footprint asks.\n  let texelsAcross = f32(textureDimensions(caustics).x);\n  let pixelAt = frame.camera.w;  // radians a pixel\n  var light = vec3f(0.0);\n  let offset = dither(pixel);\n  // The swell's drift of the chop, found once, at the march's middle: it\n  // varies over tens of metres, and the march is shorter than that.\n  let middle = frame.camera.xyz + dir * (dist * 0.5);\n  let drift = swellDriftAt(middle.xz + sun.xz * (frame.water.x - middle.y) / max(sun.y, 0.1),\n                           frame.screen.z);\n  for (var i = 0; i < steps; i++) {\n    let t = (f32(i) + offset) * dt;\n    let p = frame.camera.xyz + dir * t;\n    // Under the surface only.\n    if (p.y >= frame.water.x) { continue; }\n    let toSurface = (frame.water.x - p.y) / max(sun.y, 0.1);\n    let onSurface = p.xz + sun.xz * toSurface - drift;\n    let uv = onSurface / causticTile;\n    // Three levels softer than the pixel asks: the fine matter the light\n    // scatters from blurs the columns, the small cells merge, and only\n    // the broad bright filaments are left to make rays.\n    let lod = 3.5 + log2(max(1.0, t * pixelAt * texelsAcross / causticTile));\n    let gathered = mix(textureSampleLevel(caustics, rippleSampler, uv, layer, lod).rgb,\n                       textureSampleLevel(caustics, rippleSampler, uv, next, lod).rgb,\n                       blend) * causticBrightest;\n    // The rays are the light above the mean, a few times over; the mean\n    // itself an even glow, dimmer.\n    // Rising smoothly from the mean, so a ray's edge is soft.\n    let above = max(gathered - vec3f(0.9), vec3f(0.0));\n    let rays = above * above * 2.0;\n    let focus = mix(vec3f(1.0), vec3f(0.35) + rays, frame.water.y);\n    // The sun's light at the step: taken by the water on its way down;\n    // and what scatters toward the camera, taken on its way there.\n    let down = exp(-extinct * toSurface);\n    let toCamera = exp(-extinct * t);\n    light += frame.sunlight.rgb * focus * down * toCamera * dt;\n  }\n  return vec4f(light * extinct * scatter * frame.shaft.x, 1.0);\n}\n"

/-- `shaders/surface.wgsl`. -/
def surface : String :=
  "// The sea's surface, seen from below (`Reef/Render.lean`): a grid of the\n// plane at the water's height, centred on the camera, its cells small\n// near and growing with distance, each vertex lifted by the sea's\n// height at that moment (`seaAt`, in shaders/frame.wgsl: the same\n// surface the caustics were baked from). From below the surface is a\n// window straight up, through which the sky shows refracted, bright,\n// with the sun in it; beyond the window's edge, about 49 degrees from\n// the vertical, the surface reflects the water below it wholly, a\n// mirror of the deep (Fresnel's equations between: some of each). Then\n// the water between the camera and the surface fogs it as everything.\n\nstruct Out {\n  @builtin(position) position : vec4f,\n  @location(0) relative : vec3f,  // to the camera\n  @location(1) normal   : vec3f,\n}\n\nconst waterIndex = 1.333;\n\n// Where a grid coordinate `c`, -1 to 1, falls: geometrically, the cells\n// growing with distance by the same fraction each, from `nearest` at\n// the centre out to `radius`.\nconst nearest = 0.04;\nfn spaced(c : f32, radius : f32) -> f32 {\n  let k = log(radius / nearest);\n  return sign(c) * nearest * (exp(k * abs(c)) - 1.0);\n}\n\n// The grid's vertices, `grid + 1` a side, indexed as the floor's lattice\n// is (`Reef.latticeIndices`): over the square `radius` either side of the\n// camera, concentrated at the centre.\n@vertex fn vs(@builtin(vertex_index) v : u32) -> Out {\n  let grid = u32(frame.surface.x);\n  let radius = frame.surface.y;\n  let cx = f32(v % (grid + 1u)) / f32(grid) * 2.0 - 1.0;\n  let cz = f32(v / (grid + 1u)) / f32(grid) * 2.0 - 1.0;\n  let offset = vec2f(spaced(cx, radius), spaced(cz, radius));\n  // Snapped to the grid's finest cell, so that the mesh does not swim\n  // as the camera moves.\n  let cell = nearest * log(radius / nearest) * 2.0 / f32(grid);\n  let snapped = floor(frame.camera.xz / cell) * cell;\n  let world = snapped + offset;\n  let sea = seaAt(world);\n  var out : Out;\n  out.relative = vec3f(world.x - frame.camera.x, frame.water.x + sea.x - frame.camera.y,\n                       world.y - frame.camera.z);\n  out.position = frame.viewProj * vec4f(out.relative, 1.0);\n  out.normal = normalize(vec3f(-sea.y, 1.0, -sea.z));\n  return out;\n}\n\n// The sky, looking up along `dir` (unit) from just above the surface: a\n// gradient, pale at the horizon, blue up; and the sun, a disc and its\n// glow, where the sun is in the air.\nfn sky(dir : vec3f) -> vec3f {\n  let up = clamp(dir.y, 0.0, 1.0);\n  let base = mix(vec3f(0.85, 0.92, 1.0), vec3f(0.25, 0.45, 0.9), pow(up, 0.6));\n  let sunAir = sunInAir();\n  let toSun = max(dot(dir, -sunAir), 0.0);\n  let disc = pow(toSun, 600.0) * 30.0;\n  let glow = pow(toSun, 24.0) * 0.9;\n  return base + vec3f(1.0, 0.95, 0.85) * (disc + glow);\n}\n\n// The sun's light as it comes through the air: the water's direction is\n// the sun's (`frame.sun`, where the light comes from, under water);\n// Snell's law gives the air's, bent further from the vertical.\nfn sunInAir() -> vec3f {\n  let down = -frame.sun.xyz;\n  let horizontal = down.xz;\n  let sinWater = length(horizontal);\n  let sinAir = min(waterIndex * sinWater, 0.9995);\n  let cosAir = sqrt(1.0 - sinAir * sinAir);\n  let along = horizontal / max(sinWater, 1e-5);\n  return vec3f(along.x * sinAir, -cosAir, along.y * sinAir);\n}\n\n@fragment fn fs(in : Out) -> @location(0) vec4f {\n  let dist = length(in.relative);\n  let toSurface = in.relative / max(dist, 1e-4);\n  // The normal at the pixel, from the sea itself, which the grid is too\n  // coarse for far out; the vertices' where the sea is finer than the\n  // pixel.\n  let world = in.relative.xz + frame.camera.xz;\n  let sea = seaAt(world);\n  let fine = normalize(vec3f(-sea.y, 1.0, -sea.z));\n  let coarse = normalize(in.normal);\n  let n = normalize(mix(fine, coarse, smoothstep(40.0, 120.0, dist)));\n  let cosI = max(dot(n, toSurface), 0.0);\n  let sinT = waterIndex * sqrt(max(1.0 - cosI * cosI, 0.0));\n  var reflectance = 1.0;\n  var through = vec3f(0.0);\n  if (sinT < 1.0) {\n    let cosT = sqrt(1.0 - sinT * sinT);\n    // Fresnel, unpolarised, from water into air.\n    let rs = (waterIndex * cosI - cosT) / (waterIndex * cosI + cosT);\n    let rp = (cosT - waterIndex * cosI) / (cosT + waterIndex * cosI);\n    reflectance = 0.5 * (rs * rs + rp * rp);\n    let inAir = refract(toSurface, -n, waterIndex);\n    through = sky(inAir) * (1.0 - reflectance);\n  }\n  // Reflected: the floor, as it is lit, seen through the water the\n  // mirrored ray crosses to reach it, where the ray goes down; the\n  // water's own colour where it does not. Over bright sand in shallow\n  // water the ceiling is a bright mirror near the window, and the\n  // water's blue far off, where the ray grazes.\n  let mirrored = reflect(toSurface, n);\n  // The sand's light has come down through the water, and goes up\n  // through it again to the surface: the water's colour twice over, and\n  // the sun's warmth mostly gone from it.\n  let sandLit = vec3f(0.66, 0.5, 0.26) * 0.6\n    * (frame.skylight.rgb + frame.sunlight.rgb * max(frame.sun.y, 0.0) * 0.5);\n  let floorBelow = frame.water.x;  // the surface's height over the floor's zero\n  let toFloor = select(1e9, floorBelow / max(-mirrored.y, 1e-4), mirrored.y < -1e-4);\n  // Mostly the water's own colour, a little of the floor: at a few metres\n  // over sand the underside is a dark blue mirror with the floor faint\n  // in it, brighter the steeper the ray goes down.\n  let floorSeen = select(vec3f(0.0), fogged(sandLit, mirrored * toFloor * 2.5), toFloor < 1e8);\n  let below = water(mirrored) * 1.5 + floorSeen * 0.3 * max(-mirrored.y, 0.0);\n  let colour = through + below * reflectance;\n  return vec4f(fogged(colour, in.relative), 1.0);\n}\n"

/-- `shaders/wire.wgsl`. -/
def wire : String :=
  "// The wireframe: for every material's shader, which the program puts this\n// before, a fragment entry drawing the mesh's edges over its triangles.\n// The triangles are drawn again, with no indices, every corner its own\n// vertex, so that the vertex shader can give each corner its barycentric\n// coordinate (`barycentric`, from the vertex's index, at location 7, which\n// every material's vertex output carries): across a triangle they\n// interpolate to the distances from its edges, and `fwidth` says how far\n// a pixel is, so the edges are lines a pixel and a half wide, anti-aliased,\n// whatever the distance, as the grid's are. Being the same triangles, they\n// are at the same depth as the material's, and pass a test of less or\n// equal. They fade as the triangles shrink on the screen (far off, or\n// fine), gone below a few pixels, where they would pile up opaque: the\n// derivatives say how many pixels a triangle spans.\n\n// Corner `index % 3`'s barycentric coordinate.\nfn barycentric(index : u32) -> vec3f {\n  let corner = index % 3u;\n  return vec3f(f32(corner == 0u), f32(corner == 1u), f32(corner == 2u));\n}\n\n@fragment fn fs_wire(@location(7) bary : vec3f) -> @location(0) vec4f {\n  let width = max(fwidth(bary), vec3f(1e-6));\n  // The distance to the nearest edge, in pixels: a line a pixel wide.\n  let d = bary / width;\n  let edge = min(min(d.x, d.y), d.z);\n  let line = 1.0 - smoothstep(0.3, 1.0, edge);\n  // The triangle's size on the screen, in pixels, about (the mean of its\n  // longest and shortest, as a foreshortened one is long one way): the\n  // lines go as it falls below three pixels, gone at one.\n  let longest = 1.0 / min(min(width.x, width.y), width.z);\n  let shortest = 1.0 / max(max(width.x, width.y), width.z);\n  let size = sqrt(longest * shortest);\n  let alpha = line * smoothstep(1.0, 3.0, size);\n  if (alpha < 0.004) {\n    discard;\n  }\n  return vec4f(0.05, 0.1, 0.45, alpha);\n}\n"

end Reef.Shaders
